#!/bin/sh
# Bring up the BaseOS USB gadget and recover peripheral-mode disconnects.
#
# The optional argument is `setup`; omitting it has the same effect. The script
# composes the configfs gadget, starts adbd, and performs one bounded initial
# bind, then starts an event-driven recovery helper. Run by init.d/dev.
#
# This is an optional convenience and NEVER a boot dependency: there is no
# `set -e`, every failure path exits 0 silently, and every wait is a bounded
# loop. The recovery helper blocks on kernel events while idle.
# If the kernel USB bits or the hardware are absent the whole thing is a
# no-op. init.d/dev launches setup backgrounded so it never serialises boot.
#
# The sunxi OTG role manager clears the gadget's UDC binding on disconnect,
# including light sleep on some H700 kernels. The recovery helper only restores
# an existing gadget when the safe otg_role status reports usb_device. It never
# selects a role: intentional host use and unknown roles are left alone.
# A later cable attach can still select host mode; recovery does not override it.
#
# CRITICAL sunxi trap (measured on rg40xxv, 4.9.170): the role manager's role
# controls must NOT be touched by this script or the recovery helper.
# Reading otg_role (status only) is safe; the helper uses that to gate recovery.
#   * Writing usbc0/otg_role (e.g. "usb_device") wedges the writer in an
#     uninterruptible (D) kernel state forever — reproduced both with and
#     without a gadget bound — so a boot script that wrote it would leak a
#     stuck process every boot and never bring adb up.
#   * The siblings usbc0/usb_device, usbc0/usb_host, usbc0/usb_null are 0400
#     READ-triggers — merely cat-ing one switches the controller role and can
#     wedge the port.
# We only ever write g1/UDC (the safe, proven mechanism) and leave the manager
# in its default auto (ID-pin/VBUS) mode: the built-in UDC is always present, we
# bind our gadget to it, and the manager auto-selects peripheral mode when a
# host cable is attached. This also leaves charging on the shared port alone.

# Env-overridable roots so the unit test can drive a fake tree on a non-Linux
# host (see tests/test-usb-gadget-adb.sh); the same pattern timedatectl uses.
SYS="${BASEOS_SYS_ROOT:-/sys}"
FFS_DIR="${BASEOS_FFS_DIR:-/dev/usb-ffs/adb}"
ADBD="${BASEOS_ADBD:-/usr/sbin/adbd}"
WATCHER=/usr/sbin/usb-gadget-watch
STORAGE_DEVICE_FILE="${BASEOS_STORAGE_DEVICE_FILE:-/run/usb-storage-device}"
MOUNTS="${BASEOS_PROC_MOUNTS:-/proc/mounts}"

UDC_DIR="$SYS/class/udc"
CONFIGFS="$SYS/kernel/config"
GADGET="$CONFIGFS/usb_gadget/g1"

# Test hook: when BASEOS_SYS_ROOT is set we are running against a fake tree, not
# real hardware, so skip the configfs/functionfs mounts, pidof and adbd launch —
# the writes into the fake gadget tree are what the test asserts. Never set
# on-device, where these steps are all required.
if [ -n "${BASEOS_SYS_ROOT:-}" ]; then
	TEST_MODE=1
else
	TEST_MODE=
fi

# first_udc: echo the name of the first UDC, or return 1 if none is present.
# A single scan with no wait — callers that need to wait loop around it.
first_udc() {
	for u in "$UDC_DIR"/*; do
		[ -e "$u" ] || continue
		echo "${u##*/}"
		return 0
	done
	return 1
}

gadget_is_bound() {
	# Configfs attributes report a synthetic non-zero stat size even when their
	# contents are empty, so `test -s g1/UDC` is wrong on the real kernel. Read
	# the value instead (the fake-tree unit test catches the same contract).
	bound_udc=
	[ -r "$GADGET/UDC" ] && IFS= read -r bound_udc < "$GADGET/UDC"
	[ -n "$bound_udc" ]
}

start_watcher() {
	[ -z "$TEST_MODE" ] || return 0
	[ -x "$WATCHER" ] || return 0
	# The helper holds a lifetime flock, so repeated setup cannot duplicate it.
	# Setup can also run from an interactive ADB/SSH session. Keep recovery
	# alive when that session disconnects, and do not retain its input.
	(trap '' HUP; exec "$WATCHER") </dev/null >/dev/null 2>&1 &
}

storage_status() {
	[ -z "$TEST_MODE" ] || return 0
	case "$1" in
		ready)  : > /run/usb-storage-ready ;;
		failed) : > /run/usb-storage-failed ;;
	esac
}

storage_device_or_child_is_mounted() {
	device="$1"
	# Fail closed when current mount ownership cannot be established.
	[ -r "$MOUNTS" ] || return 0
	awk -v device="$device" '
		$1 == device || index($1, device "p") == 1 { found = 1 }
		END { exit found ? 0 : 1 }
	' "$MOUNTS" 2>/dev/null
}

do_setup() {
	# adb defaults on (same posture as dropbear); /data/no-adb disables just the
	# adb function. USB storage is independently selected by rcS, which writes
	# the safely-unmounted block device into /run. The env overrides are test
	# hooks and also make one-off diagnosis possible without changing policy.
	adb_enabled=1
	if [ -e /data/no-adb ] || [ -n "${BASEOS_DISABLE_ADB:-}" ]; then
		adb_enabled=
	fi
	storage_device="${BASEOS_STORAGE_DEVICE:-}"
	if [ -z "$storage_device" ] && [ -r "$STORAGE_DEVICE_FILE" ]; then
		IFS= read -r storage_device < "$STORAGE_DEVICE_FILE"
	fi
	storage_requested=
	[ -n "$storage_device" ] && storage_requested=1
	if [ -n "$storage_device" ]; then
		if [ -n "$TEST_MODE" ]; then
			[ -e "$storage_device" ] || storage_device=
		else
			# Defence in depth: rcS kept it unmounted. Refuse a missing
			# or non-block backing device even if /run is stale.
			[ -b "$storage_device" ] || storage_device=
		fi
		# A whole-card LUN must reject mounted child partitions too. Checking
		# only `/dev/mmcblk1` would miss `/dev/mmcblk1p1`.
		if [ -n "$storage_device" ] \
			&& storage_device_or_child_is_mounted "$storage_device"; then
			storage_device=
		fi
	fi
	if [ -z "$adb_enabled" ] && [ -z "$storage_device" ]; then
		[ -z "$storage_requested" ] || storage_status failed
		return 0
	fi

	# Idempotent re-entry (suspend/resume, manual re-run): a gadget that is
	# already bound to a UDC is left completely alone.
	if [ -d "$GADGET" ] && gadget_is_bound; then
		start_watcher
		return 0
	fi

	# Wait up to ~5s for a UDC to appear. None => no USB device controller on
	# this kernel/board; a silent no-op is the correct behaviour. (We do NOT
	# force the role — see the trap above; the UDC is present regardless.)
	udc=
	n=0
	while [ "$n" -lt 20 ]; do
		udc="$(first_udc)"
		[ -n "$udc" ] && break
		sleep 0.25 2>/dev/null || sleep 1
		n=$((n + 1))
	done
	[ -n "$udc" ] || return 0

	# configfs carries the gadget tree. Mount it if the kernel hasn't; bail if
	# this kernel lacks CONFIGFS_F_FS (no usb_gadget dir).
	if [ -z "$TEST_MODE" ]; then
		if ! grep -q " $CONFIGFS configfs " /proc/mounts 2>/dev/null; then
			mount -t configfs none "$CONFIGFS" 2>/dev/null
		fi
	fi
	[ -d "$CONFIGFS/usb_gadget" ] || return 0

	# Compose gadget g1. mkdir -p is safe on configfs (returns 0 on an existing
	# node) so re-runs before a bind just re-assert the same values.
	mkdir -p "$GADGET" 2>/dev/null || return 0
	# Android's host-side adb matches its interface by class/subclass/protocol
	# (ff/42/01), NOT by these ids. The same stable IDs identify the optional
	# composite adb + storage gadget.
	echo 0x18d1 > "$GADGET/idVendor" 2>/dev/null
	echo 0x4e42 > "$GADGET/idProduct" 2>/dev/null

	# Serial: prefer the bootloader's androidboot.serialno, then the machine-id,
	# then a constant — it only has to be a stable non-empty string.
	serial=
	for w in $(cat /proc/cmdline 2>/dev/null); do
		case "$w" in
			androidboot.serialno=*) serial="${w#androidboot.serialno=}" ;;
		esac
	done
	[ -n "$serial" ] || { [ -s /run/machine-id ] && IFS= read -r serial < /run/machine-id; }
	[ -n "$serial" ] || serial=baseos

	# Product string = the device model from /etc/baseos-release (build-rootfs
	# bakes BASEOS_MODEL there); fall back to a constant.
	BASEOS_MODEL=BaseOS
	[ -r /etc/baseos-release ] && . /etc/baseos-release 2>/dev/null
	model="${BASEOS_MODEL:-BaseOS}"

	mkdir -p "$GADGET/strings/0x409" 2>/dev/null
	echo "$serial" > "$GADGET/strings/0x409/serialnumber" 2>/dev/null
	echo BaseOS     > "$GADGET/strings/0x409/manufacturer" 2>/dev/null
	echo "$model"   > "$GADGET/strings/0x409/product" 2>/dev/null

	mkdir -p "$GADGET/configs/c.1/strings/0x409" 2>/dev/null

	if [ -n "$adb_enabled" ]; then
		mkdir -p "$GADGET/functions/ffs.adb" 2>/dev/null
		[ -e "$GADGET/configs/c.1/ffs.adb" ] \
			|| ln -s "$GADGET/functions/ffs.adb" "$GADGET/configs/c.1/ffs.adb" 2>/dev/null

		# FunctionFS endpoint + the daemon that services it.
		mkdir -p "$FFS_DIR" 2>/dev/null
		if [ -z "$TEST_MODE" ]; then
			if ! grep -q " $FFS_DIR functionfs " /proc/mounts 2>/dev/null; then
				mount -t functionfs adb "$FFS_DIR" 2>/dev/null
			fi
			# This minimal OS does not otherwise need loopback and may leave it
			# down. adbd's internal smart socket is bound to 127.0.0.1:5037;
			# bring lo up so that private control socket can start. The USB
			# transport remains the only externally reachable adb transport.
			ip link set lo up 2>/dev/null || true
			if ! pidof adbd >/dev/null 2>&1; then
				"$ADBD" >/dev/null 2>&1 &
			fi
		fi
	fi

	if [ -n "$storage_device" ]; then
		mass="$GADGET/functions/mass_storage.usb0"
		mkdir -p "$mass" 2>/dev/null || storage_device=
		# Configfs creates lun.0 automatically; the fake-tree test needs the
		# ordinary directory made explicitly.
		[ -z "$TEST_MODE" ] || mkdir -p "$mass/lun.0"
		if [ -n "$storage_device" ]; then
			echo 0 > "$mass/stall" 2>/dev/null
			echo 1 > "$mass/lun.0/removable" 2>/dev/null
			echo 0 > "$mass/lun.0/ro" 2>/dev/null
			if echo "$storage_device" > "$mass/lun.0/file" 2>/dev/null; then
				if [ ! -e "$GADGET/configs/c.1/mass_storage.usb0" ]; then
					ln -s "$mass" "$GADGET/configs/c.1/mass_storage.usb0" 2>/dev/null \
						|| storage_device=
				fi
			else
				storage_device=
			fi
		fi
	fi
	if [ -z "$adb_enabled" ] && [ -z "$storage_device" ]; then
		[ -z "$storage_requested" ] || storage_status failed
		return 0
	fi

	if [ -n "$storage_device" ] && [ -n "$adb_enabled" ]; then
		configuration="adb + usb storage"
	elif [ -n "$storage_device" ]; then
		configuration="usb storage"
	else
		configuration="adb"
	fi
	echo "$configuration" > "$GADGET/configs/c.1/strings/0x409/configuration" 2>/dev/null

	# Bind: when adb is enabled the UDC only accepts the gadget after adbd has
	# written FunctionFS descriptors, so early writes fail with -EINVAL. Retry
	# for up to ~10s; storage-only normally binds on the first attempt.
	bound=
	n=0
	while [ "$n" -lt 40 ]; do
		if echo "$udc" > "$GADGET/UDC" 2>/dev/null && gadget_is_bound; then
			bound=1
			break
		fi
		sleep 0.25 2>/dev/null || sleep 1
		n=$((n + 1))
	done
	if [ -z "$TEST_MODE" ] && [ -n "$adb_enabled" ] && [ -n "$bound" ] \
		&& [ ! -e /run/baseos-adb-logged ]; then
		. /usr/share/baseos/boot-log.sh
		select_boot_log
		log "adb gadget ready"
		: > /run/baseos-adb-logged
	fi
	if [ -n "$storage_requested" ]; then
		if [ -n "$storage_device" ] && [ -n "$bound" ]; then
			storage_status ready
		else
			storage_status failed
		fi
	fi
	start_watcher
}

case "${1:-setup}" in
	setup) do_setup ;;
esac

exit 0
