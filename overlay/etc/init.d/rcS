#!/bin/sh
# H700 base OS early init. Normal-boot budget: well under one second — no
# sleeps, anything slow runs in the background. USB-storage and charger boots
# take separate paths before any frontend session starts.

/bin/mount -t proc -o nodev,noexec,nosuid proc /proc
/bin/mount -t sysfs -o nodev,noexec,nosuid sys /sys
# The SP vendor kernels expose a low-power suspend policy switch. Stock applies
# its persisted Super Standby bit as value 16; non-SP kernels have no such file
# and already fully stop their USB host controllers during `mem` suspend.
os_sleep=/sys/class/power_supply/axp2202-battery/os_sleep
[ -w "$os_sleep" ] && printf '16' > "$os_sleep"
grep -q ' /dev devtmpfs ' /proc/mounts || /bin/mount -t devtmpfs dev /dev
# The kernel clock counts from zero until the RTC sets it, and the input devices
# register before that. A kernel that registers the last of them within its
# first second leaves /dev/input with a modification time of zero. SDL's
# gamepad scan without udev starts from that same value, sees no change and
# never looks. Stock startup registered them in the second second, so give the
# directory the time it always had. -c: never create a file in its place.
/bin/touch -c -d @1 /dev/input 2>/dev/null

# Root filesystem. The vendor initramfs used to run e2fsck on it and mount it
# writable; a boot without that initramfs arrives here with the kernel's own
# read-only mount instead. Finish the job the same way, so the rest of the
# system cannot tell which boot pair is installed. The kernel has already
# replayed the journal, so a check is only due when the filesystem carries
# recorded errors. e2fsck repairs a mounted root behind the kernel's back: when
# it changed anything, keep the root read-only until the next restart rather
# than write through stale cached state. Nothing runs here on a root that is
# already writable.
root_opts=
while read -r _ root_dir _ root_o _; do
	[ "$root_dir" != / ] || root_opts=$root_o
done < /proc/mounts
case ",$root_opts," in *,ro,*)
	root_errors=0
	[ ! -r /sys/fs/ext4/mmcblk0p5/errors_count ] \
		|| read -r root_errors < /sys/fs/ext4/mmcblk0p5/errors_count
	root_fsck=0
	if [ "$root_errors" != 0 ] && [ -x /usr/sbin/e2fsck ]; then
		/usr/sbin/e2fsck -y /dev/mmcblk0p5 >/dev/null 2>&1 || root_fsck=$?
		echo "baseos: root filesystem had $root_errors recorded errors; e2fsck exit $root_fsck" > /dev/kmsg
	fi
	if [ "$root_fsck" -eq 0 ]; then
		/bin/mount -o remount,rw,noatime,nodiratime,nobarrier,noauto_da_alloc / 2>/dev/null \
			|| /bin/mount -o remount,rw,noatime / 2>/dev/null \
			|| echo 'baseos: root filesystem stays read-only: remount failed' > /dev/kmsg
	fi
	;;
esac

# /usr/lib. A composed image keeps the libraries in a squashfs file and the
# directory empty. The card reads about 20 MB/s and a frontend loads most of
# the 19 MB GPU library before its first frame. Compressed, that is half the
# card time, and LZ4 unpacks faster than the card delivers. Everything that runs
# before this line is static. A rootfs that still has its libraries in the
# directory, like the bare tree the QEMU test boots, has no such file.
usr_lib_image=/usr/share/baseos/usr-lib.sqfs
if [ -f "$usr_lib_image" ]; then
	/bin/mount -t squashfs -o loop,ro,nodev,nosuid "$usr_lib_image" /usr/lib 2>/dev/null \
		|| echo 'baseos: the /usr/lib image did not mount; no dynamic program can start' > /dev/kmsg
fi

/bin/mkdir -p /dev/pts /dev/shm
/bin/mount -t devpts -o gid=5,mode=620 devpts /dev/pts
# debugfs: the sunxi disp2 driver's only display-output control surface is
# /sys/kernel/debug/dispdbg — it is what switches disp0 between the LCD and the
# HDMI TX. The stock OS got this mount for free from systemd; without it the
# frontend's HDMI switch silently no-ops and a plugged-in TV stays dark while
# the 720p UI is scaled onto the internal panel (issue #10).
/bin/mount -t debugfs -o nodev,noexec,nosuid debugfs /sys/kernel/debug
/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs /dev/shm
/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs /tmp
/bin/mount -t tmpfs -o mode=755,size=32m tmpfs /run
/bin/mount -t tmpfs -o mode=755,size=64m tmpfs /var

# The kernel latches the boot reason before userspace starts. A normal boot
# takes only shell builtins here; use an exact cmdline token on older kernels.
boot_mode=
if [ -r /sys/class/power_supply/axp2202-battery/boot_mode ]; then
	read -r boot_mode < /sys/class/power_supply/axp2202-battery/boot_mode
fi
case "$boot_mode" in
	0|1) ;;
	*)
		read -r boot_cmdline < /proc/cmdline
		case " $boot_cmdline " in *' bootreason=charger '*) boot_mode=1 ;; esac
		;;
esac
if [ "$boot_mode" = 1 ]; then
	# This blocks rcS (and therefore init's respawns) until explicit boot
	# intent. No GPU, network, card mount or update-trial work has begun.
	while ! /usr/sbin/baseos-charger; do /bin/sleep 60; done
fi

# /var skeleton (tmpfs). Persistent pieces live on /data and are linked below.
/bin/mkdir -p /var/lib /var/log /var/tmp /var/lib/alsa /var/lib/bluealsa /var/empty
/bin/ln -s /run /var/run

# udev, with input rules only. SDL learns device types from its database (the
# 32-bit SDL2 finds no gamepad without it) and hears about devices that appear
# later, such as the virtual keyboard gptokeyb creates as a port starts.
/usr/lib/systemd/systemd-udevd --daemon --resolve-names=never >/dev/null 2>&1
/usr/bin/udevadm trigger --subsystem-match=input --action=add >/dev/null 2>&1 &

# GPU: the build strips debug data from the vendor module. Load it in the
# background to overlap startup; frontend-session waits for /dev/mali0.
/sbin/insmod /lib/modules/mali_kbase.ko 2>/dev/null &

# USB host controllers: the boot files hold back every one except the one the
# OTG port needs, so the kernel does not spend 0.3 s starting them before init.
# This module starts them now, beside the rest of startup. On boot files that
# hold nothing back it finds nothing to do.
[ ! -f /lib/modules/h700_late_usb.ko ] || /sbin/insmod /lib/modules/h700_late_usb.ko 2>/dev/null &

# Persistent state partition (p6, label "userdata"). It survives system
# updates: an A/B slot flip only moves the rootfs partition.
/bin/mkdir -p /data
if ! /bin/mount -t ext4 -o rw,noatime /dev/mmcblk0p6 /data 2>/dev/null; then
	/bin/mount -t tmpfs tmpfs /data
fi
/bin/mkdir -p /data/bluetooth /data/bluealsa /data/dropbear
/bin/ln -sfn /data/bluetooth /var/lib/bluetooth

# A freshly updated slot is on trial until a frontend session starts. Count the
# boots that never got that far and restore the previous slot if this one
# cannot. No-op unless an update is in its trial window.
[ -x /usr/sbin/baseos-update ] && /usr/sbin/baseos-update boot-check

# Restore the selected timezone. /etc/localtime is baked as a symlink to
# /run/localtime because the root filesystem is read-only; timedatectl keeps
# the selected zone name on the persistent /data partition.
[ -x /usr/bin/timedatectl ] && /usr/bin/timedatectl apply 2>/dev/null

# Entropy: restore last boot's seed (kernel 4.9 is slow to gather on its own).
[ -f /data/random-seed ] && /bin/cat /data/random-seed > /dev/urandom 2>/dev/null

# System clock from RTC (stock delegated this to systemd; rc.local had it disabled).
# -u is mandatory: the RTC holds UTC (baseos-ntp-notify writes it with -u -w), and
# absent that flag busybox reads the RTC as local time and rewinds the clock by the
# zone offset, so the frontend shows UTC until ntpd corrects it minutes later. The
# usual alternative — an adjtime file declaring UTC — cannot work here: this
# busybox looks for it at /var/lib/hwclock/adjtime, and /var is tmpfs.
/sbin/hwclock -u -s 2>/dev/null &

# Radio initialization stays in the background: never delay frontend handoff.
# The vendor kernel can enumerate the bootloader-powered SDIO card, then turn
# off its unused WLAN regulator. Discard that stale card while power is still
# off, before 8821cs powers it up and registers its driver. Otherwise the driver
# probes the stale card concurrently with its own rescan (-123 on H700).
# Frontends own association/DHCP and may still need to wait for wlan0.
#
# Some radios only reset properly after a long power-off. The kernel cuts the
# supply at about 1.85 s and the driver re-powers it about 0.6 s later; on
# those units the fresh card then answers with a corrupt SDIO ID (020C:C821)
# or not at all, while stock, which loads the driver ~3.8 s after the cut,
# works. When the first enumeration fails, unload the driver (it powers the
# radio off), keep it off for a stock-length interval, and load again. Remember
# that on /data so later boots hold the first load instead of failing first.
# Units whose first attempt works, the common case, are unaffected.
(
	# Stock loads the Bluetooth wake-handshake driver during early boot
	# (/etc/modules); its probe drives BT_WAKE (PG17) high. Keep that state,
	# and keep it ahead of the WiFi driver. Loading it takes about 40 ms.
	[ ! -f /lib/modules/rtl_btlpm.ko ] || /sbin/insmod /lib/modules/rtl_btlpm.ko 2>/dev/null
	wifi_slow=/data/wifi-slow-radio
	wifi_off_cs=500                 # power-off interval, centiseconds (stock: ~380)
	wifi_cut_cs=185                 # kernel disables the WLAN supply about here
	wifi_first_cs=225               # startup used to reach the first load about here
	wifi_uptime() {                 # centiseconds; empty when unavailable
		read -r wifi_up _ < /proc/uptime 2>/dev/null || wifi_up=
		wifi_up="${wifi_up%.*}${wifi_up#*.}"
		while [ "${wifi_up#0}" != "$wifi_up" ]; do wifi_up="${wifi_up#0}"; done
	}
	wifi_hold_until() {             # bounded wait for uptime >= $1 cs
		wifi_n=0
		wifi_uptime
		while [ -n "$wifi_up" ] && [ "$wifi_up" -lt "$1" ] && [ "$wifi_n" -lt 80 ]; do
			sleep 0.25 2>/dev/null || sleep 1
			wifi_n=$((wifi_n + 1))
			wifi_uptime
		done
	}
	wifi_load() {
		wifi_rf=/sys/class/misc/sunxi-wlan/rf-ctrl
		if [ -w "$wifi_rf/scan_device" ] && [ -r "$wifi_rf/power_state" ] \
			&& read -r wifi_power < "$wifi_rf/power_state" && [ "$wifi_power" = 0 ]; then
			printf '1\n' > "$wifi_rf/scan_device"
			wifi_wait=0
			for wifi_card in /sys/bus/sdio/devices/*; do
				while [ -d "$wifi_card" ] && [ "$wifi_wait" -lt 20 ]; do
					sleep 0.05
					wifi_wait=$((wifi_wait + 1))
				done
			done
		fi
		/sbin/insmod /lib/modules/8821cs.ko 2>/dev/null
		wifi_wait=0
		while [ ! -d /sys/class/net/wlan0 ] && [ "$wifi_wait" -lt "$1" ]; do
			sleep 0.25 2>/dev/null || sleep 1
			wifi_wait=$((wifi_wait + 1))
		done
	}
	if [ -e "$wifi_slow" ]; then
		echo 'baseos: wifi: holding the driver load for a slow-resetting radio' > /dev/kmsg
		wifi_hold_until $((wifi_cut_cs + wifi_off_cs))
		wifi_load 40
	else
		# Startup now gets here sooner after the kernel cuts the WLAN supply.
		# The radio keeps the power-off interval it has always had before its
		# first power-up: start no earlier than startup used to.
		wifi_hold_until "$wifi_first_cs"
		wifi_load 8
		if [ ! -d /sys/class/net/wlan0 ]; then
			echo 'baseos: wifi: no wlan0 after the first load; retrying after a longer power-off' > /dev/kmsg
			/sbin/rmmod 8821cs 2>/dev/null
			: > "$wifi_slow" 2>/dev/null
			wifi_uptime
			[ -n "$wifi_up" ] && wifi_hold_until $((wifi_up + wifi_off_cs)) || sleep 5
			wifi_load 40
		fi
	fi
	if [ -d /sys/class/net/wlan0 ]; then
		rfkill unblock wifi 2>/dev/null || true
		ip link set wlan0 up 2>/dev/null || true
	fi
) &

# machine-id (dbus/BlueZ). /etc/machine-id is a baked symlink into /run.
if [ -s /data/machine-id ]; then
	/bin/cp /data/machine-id /run/machine-id
else
	/usr/bin/dbus-uuidgen > /run/machine-id 2>/dev/null \
		|| /bin/tr -d - < /proc/sys/kernel/random/uuid > /run/machine-id
	/bin/cp /run/machine-id /data/machine-id 2>/dev/null
fi
/bin/mkdir -p /run/dbus /var/lib/dbus
/bin/ln -sf /run/machine-id /var/lib/dbus/machine-id

# First boot on a fresh flash: grow this card's data partition to fill the
# whole card (leaving it empty for the user to add a frontend). No-op once the
# card already fills the disk.
[ -x /usr/sbin/expand-storage ] && /usr/sbin/expand-storage

# The second card slot (TF2) is powered and identified by the kernel in the
# background, about 0.4 s after its controller starts, so its card can still be
# missing when rcS gets here. Without a wait, a quick boot quietly uses TF1 as
# the frontend card, or exports the wrong disk in USB-storage mode. The kernel
# keeps the slot powered only while a card is present or still being
# identified, so follow its verdict rather than a card-detect level whose
# polarity is board-specific. An empty slot costs one read; the wait ends at
# the handoff budget whatever happens.
tf2_ios=
for tf2_host in /sys/devices/platform/soc/sdc2/mmc_host/mmc*; do
	[ -d "$tf2_host" ] && tf2_ios="/sys/kernel/debug/${tf2_host##*/}/ios"
done
tf2_powered() {
	[ -r "$tf2_ios" ] || return 1
	while IFS= read -r tf2_line; do
		case "$tf2_line" in
			'power mode:'*'(off)'*) return 1 ;;
			'power mode:'*) return 0 ;;
		esac
	done < "$tf2_ios"
	return 1
}
tf2_grace=0
while [ ! -b /dev/mmcblk1p1 ]; do
	if [ -b /dev/mmcblk1 ]; then
		# The disk is up; its partitions follow within milliseconds.
		[ "$tf2_grace" -lt 5 ] || break
		tf2_grace=$((tf2_grace + 1))
	else
		tf2_powered || break
	fi
	read -r tf2_up _ < /proc/uptime 2>/dev/null || break
	tf2_up="${tf2_up%.*}${tf2_up#*.}"
	while [ "${tf2_up#0}" != "$tf2_up" ]; do tf2_up="${tf2_up#0}"; done
	[ "${tf2_up:-0}" -lt 250 ] || break
	sleep 0.01 2>/dev/null || break
done

# MENU held from power-on selects a one-boot USB-storage maintenance mode. Check
# the current evdev state once: no timing window, input loop, or normal-boot
# delay. Because no frontend card has been mounted yet, TF2 can be exported as
# a complete disk (partition table included); without TF2, export TF1's p7.
USB_STORAGE_MODE=0
/bin/mkdir -p /mnt/sdcard
if { [ -e /run/boot-menu-held ] || /usr/sbin/boot-menu-held; } \
	&& [ -x /usr/sbin/usb-storage-mode ] \
	&& /usr/sbin/usb-storage-mode prepare; then
	USB_STORAGE_MODE=1
fi

# Normal boot mounts the frontend/data card: TF2 p1 wins if usable, else this
# card's own "primary" FAT partition (p7).
if [ "$USB_STORAGE_MODE" -eq 0 ]; then
	for dev in /dev/mmcblk1p1 /dev/mmcblk0p7; do
		[ -b "$dev" ] || continue
		if /bin/mount -t vfat -o rw,utf8,noatime,shortname=mixed "$dev" /mnt/sdcard 2>/dev/null \
			|| /bin/mount -t exfat -o rw,noatime "$dev" /mnt/sdcard 2>/dev/null; then
			break
		fi
		# One repair attempt, then retry once.
		/usr/sbin/fsck.fat -a "$dev" >/dev/null 2>&1
		if /bin/mount -t vfat -o rw,utf8,noatime,shortname=mixed "$dev" /mnt/sdcard 2>/dev/null \
			|| /bin/mount -t auto -o noatime "$dev" /mnt/sdcard 2>/dev/null; then
			break
		fi
	done
fi
# Older rootfs images may lack the alias baked into current builds.
[ "$(readlink /mnt/SDCARD)" = /mnt/sdcard ] || /bin/ln -sfn /mnt/sdcard /mnt/SDCARD

. /usr/share/baseos/boot-log.sh
select_boot_log
read -r boot_id < /proc/sys/kernel/random/boot_id
log "=== BaseOS boot $(date '+%Y-%m-%d %H:%M:%S') ($boot_id) ==="
flush_early_boot_log
if [ "$LOG" = /mnt/sdcard/baseos-boot.log ]; then
	log "rcS reached card mount"
fi

# BaseOS settings always come from TF1, even when TF2 holds the frontend. Reuse
# TF1 at /mnt/sdcard, or briefly mount it read-only for config and update scans.
# Maintenance boots use defaults without opening or mounting exported storage.
BASEOS_CONFIG=/dev/null
TF1_CONFIG_MOUNTED=0
if [ "$USB_STORAGE_MODE" -eq 0 ]; then
	if grep -q '^/dev/mmcblk0p7 /mnt/sdcard ' /proc/mounts; then
		BASEOS_CONFIG=/mnt/sdcard/baseos.conf
	else
		/bin/mkdir -p /mnt/system
		if /bin/mount -t vfat -o ro /dev/mmcblk0p7 /mnt/system 2>/dev/null; then
			TF1_CONFIG_MOUNTED=1
			BASEOS_CONFIG=/mnt/system/baseos.conf
		fi
	fi
fi
[ -x /usr/sbin/baseos-config ] && /usr/sbin/baseos-config "$BASEOS_CONFIG"

# System update: apply a *.bosupd payload the user copied onto the card. Costs
# one failed glob on an ordinary boot; when a payload is present it writes the
# inactive rootfs slot, verifies it, flips the GPT and reboots. Storage mode
# leaves every card file to the USB host; the update runs on the next normal
# boot after the user ejects and restarts without MENU.
if [ "$USB_STORAGE_MODE" -eq 0 ]; then
	[ -x /usr/sbin/baseos-update ] && /usr/sbin/baseos-update apply
fi
# Unmounting waits for the kernel's next quiet point, about 60 ms. Nothing
# below needs TF1 gone first, so let it finish beside the rest.
[ "$TF1_CONFIG_MOUNTED" -eq 0 ] || /bin/umount /mnt/system &

# Attach the audio repair before init can start a frontend and open the codec.
# The module verifies the running kernel and idle audio state before attaching.
# Skip USB-storage maintenance.
if [ "$USB_STORAGE_MODE" -eq 0 ] && [ -x /usr/sbin/h700-speaker-amp-load ]; then
	/usr/sbin/h700-speaker-amp-load >/run/h700-speaker-amp.log 2>&1
fi

# Optional TF1 startup sound. The audio repair must finish before playback;
# maintenance boots never open a card exported to the USB host.
if [ "$USB_STORAGE_MODE" -eq 0 ] && [ -x /usr/sbin/baseos-startup-sound ]; then
	/usr/sbin/baseos-startup-sound </dev/null >/run/startup-sound.log 2>&1 &
fi

# Dev image extras (serial getty is in inittab; this starts SSH).
[ -x /etc/init.d/dev ] && /etc/init.d/dev &

: # rcS must succeed; init proceeds to respawn frontend-session
