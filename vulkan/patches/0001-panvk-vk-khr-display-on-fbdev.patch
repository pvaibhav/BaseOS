diff --git a/src/vulkan/wsi/wsi_common_fbdev.c b/src/vulkan/wsi/wsi_common_fbdev.c
new file mode 100644
index 0000000..fe77869
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_fbdev.c
@@ -0,0 +1,841 @@
+/*
+ * Copyright 2026 spruceUI
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * VK_KHR_display on a Linux fbdev framebuffer, for kernels without DRM/KMS.
+ * Frames are rendered into CPU-visible images and copied into the hidden
+ * page of a double-height framebuffer, which is then panned to.
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <linux/fb.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "util/macros.h"
+#include "vk_instance.h"
+#include "vk_physical_device.h"
+#include "vk_util.h"
+#include "wsi_common_entrypoints.h"
+#include "wsi_common_private.h"
+
+#define WSI_FBDEV_MM_PER_PIXEL (1.0 / 96.0 * 25.4)
+
+struct wsi_fbdev_object {
+   int unused;
+};
+
+struct wsi_fbdev {
+   struct wsi_interface base;
+   const VkAllocationCallbacks *alloc;
+   const char *path;
+   bool found;
+   uint32_t width;
+   uint32_t height;
+   uint32_t width_mm;
+   uint32_t height_mm;
+   uint32_t refresh_mhz;
+   /* Degrees counter-clockwise the frame is turned on its way to the panel */
+   uint32_t rotation;
+   struct wsi_fbdev_object display;
+   struct wsi_fbdev_object mode;
+};
+
+static uint32_t
+wsi_fbdev_rotation(void)
+{
+   const char *env = getenv("MESA_VK_FBDEV_ROTATE");
+   unsigned deg = 0;
+
+   if (env) {
+      deg = strtoul(env, NULL, 10);
+   } else {
+      FILE *f = fopen("/etc/baseos-release", "r");
+      if (f) {
+         char line[128];
+         while (fgets(line, sizeof(line), f)) {
+            if (sscanf(line, "BASEOS_PANEL_ROTATION_CCW=%u", &deg) == 1)
+               break;
+         }
+         fclose(f);
+      }
+   }
+
+   return deg == 90 || deg == 180 || deg == 270 ? deg : 0;
+}
+
+static struct wsi_fbdev *
+wsi_fbdev_from_pdevice(VkPhysicalDevice physicalDevice)
+{
+   VK_FROM_HANDLE(vk_physical_device, pdevice, physicalDevice);
+   return (struct wsi_fbdev *)pdevice->wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+}
+
+static VkDisplayKHR
+wsi_fbdev_display_handle(struct wsi_fbdev *wsi)
+{
+   return (VkDisplayKHR)(uintptr_t)&wsi->display;
+}
+
+static VkDisplayModeKHR
+wsi_fbdev_mode_handle(struct wsi_fbdev *wsi)
+{
+   return (VkDisplayModeKHR)(uintptr_t)&wsi->mode;
+}
+
+static bool
+wsi_fbdev_is_bgra8888(const struct fb_var_screeninfo *var)
+{
+   return var->bits_per_pixel == 32 &&
+          var->blue.offset == 0 && var->blue.length == 8 &&
+          var->green.offset == 8 && var->green.length == 8 &&
+          var->red.offset == 16 && var->red.length == 8;
+}
+
+static void
+wsi_fbdev_probe(struct wsi_fbdev *wsi)
+{
+   int fd = open(wsi->path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return;
+
+   struct fb_var_screeninfo var;
+   if (ioctl(fd, FBIOGET_VSCREENINFO, &var) == 0 && wsi_fbdev_is_bgra8888(&var)) {
+      bool swap = wsi->rotation == 90 || wsi->rotation == 270;
+      wsi->found = true;
+      wsi->width = swap ? var.yres : var.xres;
+      wsi->height = swap ? var.xres : var.yres;
+      wsi->width_mm = swap ? var.height : var.width;
+      wsi->height_mm = swap ? var.width : var.height;
+
+      uint64_t htotal = var.xres + var.left_margin + var.right_margin + var.hsync_len;
+      uint64_t vtotal = var.yres + var.upper_margin + var.lower_margin + var.vsync_len;
+      if (var.pixclock && htotal && vtotal)
+         wsi->refresh_mhz = 1000000000000000ull / (var.pixclock * htotal * vtotal);
+      else
+         wsi->refresh_mhz = 60000;
+   }
+
+   close(fd);
+}
+
+static void
+wsi_fbdev_fill_display_properties(struct wsi_fbdev *wsi,
+                                  VkDisplayPropertiesKHR *prop)
+{
+   prop->display = wsi_fbdev_display_handle(wsi);
+   prop->displayName = "fbdev";
+   prop->physicalResolution = (VkExtent2D) { wsi->width, wsi->height };
+   prop->physicalDimensions = (VkExtent2D) {
+      wsi->width_mm ? wsi->width_mm : (uint32_t)(wsi->width * WSI_FBDEV_MM_PER_PIXEL + 0.5),
+      wsi->height_mm ? wsi->height_mm : (uint32_t)(wsi->height * WSI_FBDEV_MM_PER_PIXEL + 0.5),
+   };
+   prop->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   prop->planeReorderPossible = VK_FALSE;
+   prop->persistentContent = VK_FALSE;
+}
+
+static void
+wsi_fbdev_fill_mode_properties(struct wsi_fbdev *wsi,
+                               VkDisplayModePropertiesKHR *prop)
+{
+   prop->displayMode = wsi_fbdev_mode_handle(wsi);
+   prop->parameters.visibleRegion = (VkExtent2D) { wsi->width, wsi->height };
+   prop->parameters.refreshRate = wsi->refresh_mhz;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayPropertiesKHR(VkPhysicalDevice physicalDevice,
+                                          uint32_t *pPropertyCount,
+                                          VkDisplayPropertiesKHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayPropertiesKHR, out, pProperties, pPropertyCount);
+
+   if (wsi->found) {
+      vk_outarray_append_typed(VkDisplayPropertiesKHR, &out, prop)
+         wsi_fbdev_fill_display_properties(wsi, prop);
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayProperties2KHR(VkPhysicalDevice physicalDevice,
+                                           uint32_t *pPropertyCount,
+                                           VkDisplayProperties2KHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayProperties2KHR, out, pProperties, pPropertyCount);
+
+   if (wsi->found) {
+      vk_outarray_append_typed(VkDisplayProperties2KHR, &out, prop)
+         wsi_fbdev_fill_display_properties(wsi, &prop->displayProperties);
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayPlanePropertiesKHR(VkPhysicalDevice physicalDevice,
+                                               uint32_t *pPropertyCount,
+                                               VkDisplayPlanePropertiesKHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayPlanePropertiesKHR, out, pProperties, pPropertyCount);
+
+   if (wsi->found) {
+      vk_outarray_append_typed(VkDisplayPlanePropertiesKHR, &out, prop) {
+         prop->currentDisplay = wsi_fbdev_display_handle(wsi);
+         prop->currentStackIndex = 0;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayPlaneProperties2KHR(VkPhysicalDevice physicalDevice,
+                                                uint32_t *pPropertyCount,
+                                                VkDisplayPlaneProperties2KHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayPlaneProperties2KHR, out, pProperties, pPropertyCount);
+
+   if (wsi->found) {
+      vk_outarray_append_typed(VkDisplayPlaneProperties2KHR, &out, prop) {
+         prop->displayPlaneProperties.currentDisplay = wsi_fbdev_display_handle(wsi);
+         prop->displayPlaneProperties.currentStackIndex = 0;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayPlaneSupportedDisplaysKHR(VkPhysicalDevice physicalDevice,
+                                        uint32_t planeIndex,
+                                        uint32_t *pDisplayCount,
+                                        VkDisplayKHR *pDisplays)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayKHR, out, pDisplays, pDisplayCount);
+
+   if (wsi->found && planeIndex == 0) {
+      vk_outarray_append_typed(VkDisplayKHR, &out, display)
+         *display = wsi_fbdev_display_handle(wsi);
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayModePropertiesKHR(VkPhysicalDevice physicalDevice,
+                                VkDisplayKHR display,
+                                uint32_t *pPropertyCount,
+                                VkDisplayModePropertiesKHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayModePropertiesKHR, out, pProperties, pPropertyCount);
+
+   if (wsi->found) {
+      vk_outarray_append_typed(VkDisplayModePropertiesKHR, &out, prop)
+         wsi_fbdev_fill_mode_properties(wsi, prop);
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayModeProperties2KHR(VkPhysicalDevice physicalDevice,
+                                 VkDisplayKHR display,
+                                 uint32_t *pPropertyCount,
+                                 VkDisplayModeProperties2KHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayModeProperties2KHR, out, pProperties, pPropertyCount);
+
+   if (wsi->found) {
+      vk_outarray_append_typed(VkDisplayModeProperties2KHR, &out, prop)
+         wsi_fbdev_fill_mode_properties(wsi, &prop->displayModeProperties);
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_CreateDisplayModeKHR(VkPhysicalDevice physicalDevice,
+                         VkDisplayKHR display,
+                         const VkDisplayModeCreateInfoKHR *pCreateInfo,
+                         const VkAllocationCallbacks *pAllocator,
+                         VkDisplayModeKHR *pMode)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   const VkDisplayModeParametersKHR *p = &pCreateInfo->parameters;
+
+   if (pCreateInfo->flags == 0 &&
+       p->visibleRegion.width == wsi->width &&
+       p->visibleRegion.height == wsi->height &&
+       abs((int)p->refreshRate - (int)wsi->refresh_mhz) < 10) {
+      *pMode = wsi_fbdev_mode_handle(wsi);
+      return VK_SUCCESS;
+   }
+   return VK_ERROR_INITIALIZATION_FAILED;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayPlaneCapabilitiesKHR(VkPhysicalDevice physicalDevice,
+                                   VkDisplayModeKHR mode,
+                                   uint32_t planeIndex,
+                                   VkDisplayPlaneCapabilitiesKHR *pCapabilities)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VkExtent2D extent = { wsi->width, wsi->height };
+
+   *pCapabilities = (VkDisplayPlaneCapabilitiesKHR) {
+      .supportedAlpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR,
+      .minSrcExtent = extent,
+      .maxSrcExtent = extent,
+      .minDstExtent = extent,
+      .maxDstExtent = extent,
+   };
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayPlaneCapabilities2KHR(VkPhysicalDevice physicalDevice,
+                                    const VkDisplayPlaneInfo2KHR *pDisplayPlaneInfo,
+                                    VkDisplayPlaneCapabilities2KHR *pCapabilities)
+{
+   vk_foreach_struct(ext, pCapabilities->pNext) {
+      if (ext->sType == VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR)
+         ((VkSurfaceProtectedCapabilitiesKHR *)ext)->supportsProtected = VK_FALSE;
+   }
+
+   return wsi_GetDisplayPlaneCapabilitiesKHR(physicalDevice,
+                                             pDisplayPlaneInfo->mode,
+                                             pDisplayPlaneInfo->planeIndex,
+                                             &pCapabilities->capabilities);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_CreateDisplayPlaneSurfaceKHR(VkInstance _instance,
+                                 const VkDisplaySurfaceCreateInfoKHR *pCreateInfo,
+                                 const VkAllocationCallbacks *pAllocator,
+                                 VkSurfaceKHR *pSurface)
+{
+   VK_FROM_HANDLE(vk_instance, instance, _instance);
+   VkIcdSurfaceDisplay *surface;
+
+   surface = vk_zalloc2(&instance->alloc, pAllocator, sizeof(*surface), 8,
+                        VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (surface == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   surface->base.platform = VK_ICD_WSI_PLATFORM_DISPLAY;
+   surface->displayMode = pCreateInfo->displayMode;
+   surface->planeIndex = pCreateInfo->planeIndex;
+   surface->planeStackIndex = pCreateInfo->planeStackIndex;
+   surface->transform = pCreateInfo->transform;
+   surface->globalAlpha = pCreateInfo->globalAlpha;
+   surface->alphaMode = pCreateInfo->alphaMode;
+   surface->imageExtent = pCreateInfo->imageExtent;
+
+   *pSurface = VkIcdSurfaceBase_to_handle(&surface->base);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_surface_get_support(VkIcdSurfaceBase *surface,
+                              struct wsi_device *wsi_device,
+                              uint32_t queueFamilyIndex,
+                              VkBool32 *pSupported)
+{
+   struct wsi_fbdev *wsi =
+      (struct wsi_fbdev *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+
+   *pSupported = wsi->found;
+   return VK_SUCCESS;
+}
+
+static const VkPresentModeKHR wsi_fbdev_present_modes[] = {
+   VK_PRESENT_MODE_FIFO_KHR,
+   VK_PRESENT_MODE_MAILBOX_KHR,
+   VK_PRESENT_MODE_IMMEDIATE_KHR,
+};
+
+static VkResult
+wsi_fbdev_surface_get_capabilities2(VkIcdSurfaceBase *icd_surface,
+                                    struct wsi_device *wsi_device,
+                                    const void *info_next,
+                                    VkSurfaceCapabilities2KHR *caps)
+{
+   VkIcdSurfaceDisplay *surface = (VkIcdSurfaceDisplay *)icd_surface;
+   VkSurfaceCapabilitiesKHR *c = &caps->surfaceCapabilities;
+   VK_FROM_HANDLE(vk_physical_device, pdevice, wsi_device->pdevice);
+
+   c->minImageCount = 2;
+   c->maxImageCount = 0;
+   c->currentExtent = surface->imageExtent;
+   c->minImageExtent = surface->imageExtent;
+   c->maxImageExtent = surface->imageExtent;
+   c->maxImageArrayLayers = 1;
+   c->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   c->currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   c->supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+
+   VkImageUsageFlags image_usage = wsi_caps_get_image_usage();
+   if (pdevice->supported_extensions.EXT_attachment_feedback_loop_layout)
+      image_usage |= VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+
+   VkImageUsageFlags2CreateInfoKHR *usage2 =
+      vk_find_struct(caps->pNext, IMAGE_USAGE_FLAGS_2_CREATE_INFO_KHR);
+   if (usage2)
+      usage2->usage = image_usage;
+   else
+      c->supportedUsageFlags = image_usage;
+
+   const VkSurfacePresentModeKHR *present_mode =
+      vk_find_struct_const(info_next, SURFACE_PRESENT_MODE_EXT);
+
+   vk_foreach_struct(ext, caps->pNext) {
+      switch (ext->sType) {
+      case VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR:
+         ((VkSurfaceProtectedCapabilitiesKHR *)ext)->supportsProtected = VK_FALSE;
+         break;
+
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_KHR: {
+         VkSurfacePresentScalingCapabilitiesKHR *scaling = (void *)ext;
+         scaling->supportedPresentScaling = 0;
+         scaling->supportedPresentGravityX = 0;
+         scaling->supportedPresentGravityY = 0;
+         scaling->minScaledImageExtent = c->minImageExtent;
+         scaling->maxScaledImageExtent = c->maxImageExtent;
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_COMPATIBILITY_KHR: {
+         VkSurfacePresentModeCompatibilityKHR *compat = (void *)ext;
+         if (compat->pPresentModes == NULL) {
+            compat->presentModeCount = 1;
+         } else if (compat->presentModeCount && present_mode) {
+            compat->presentModeCount = 1;
+            compat->pPresentModes[0] = present_mode->presentMode;
+         }
+         break;
+      }
+
+      default:
+         break;
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+static const VkFormat wsi_fbdev_formats[] = {
+   VK_FORMAT_B8G8R8A8_UNORM,
+   VK_FORMAT_B8G8R8A8_SRGB,
+};
+
+static VkResult
+wsi_fbdev_surface_get_formats(VkIcdSurfaceBase *surface,
+                              struct wsi_device *wsi_device,
+                              uint32_t *pSurfaceFormatCount,
+                              VkSurfaceFormatKHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(wsi_fbdev_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormatKHR, &out, f) {
+         f->format = wsi_fbdev_formats[i];
+         f->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_fbdev_surface_get_formats2(VkIcdSurfaceBase *surface,
+                               struct wsi_device *wsi_device,
+                               const void *info_next,
+                               uint32_t *pSurfaceFormatCount,
+                               VkSurfaceFormat2KHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(wsi_fbdev_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, f) {
+         f->surfaceFormat.format = wsi_fbdev_formats[i];
+         f->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_fbdev_surface_get_present_modes(VkIcdSurfaceBase *surface,
+                                    struct wsi_device *wsi_device,
+                                    uint32_t *pPresentModeCount,
+                                    VkPresentModeKHR *pPresentModes)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkPresentModeKHR, out, pPresentModes, pPresentModeCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(wsi_fbdev_present_modes); i++) {
+      vk_outarray_append_typed(VkPresentModeKHR, &out, mode)
+         *mode = wsi_fbdev_present_modes[i];
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_fbdev_surface_get_present_rectangles(VkIcdSurfaceBase *icd_surface,
+                                         struct wsi_device *wsi_device,
+                                         uint32_t *pRectCount,
+                                         VkRect2D *pRects)
+{
+   VkIcdSurfaceDisplay *surface = (VkIcdSurfaceDisplay *)icd_surface;
+   VK_OUTARRAY_MAKE_TYPED(VkRect2D, out, pRects, pRectCount);
+
+   vk_outarray_append_typed(VkRect2D, &out, rect) {
+      *rect = (VkRect2D) { .offset = { 0, 0 }, .extent = surface->imageExtent };
+   }
+   return vk_outarray_status(&out);
+}
+
+struct wsi_fbdev_image {
+   struct wsi_image base;
+   bool acquired;
+};
+
+struct wsi_fbdev_swapchain {
+   struct wsi_swapchain base;
+   int fd;
+   uint8_t *map;
+   size_t map_size;
+   struct fb_var_screeninfo var;
+   uint32_t orig_yoffset;
+   uint32_t line_length;
+   uint32_t pages;
+   uint32_t page;
+   uint32_t rotation;
+   /* What the framebuffer held before us, put back on destroy */
+   uint8_t *saved;
+   VkExtent2D extent;
+   struct wsi_fbdev_image images[0];
+};
+
+static struct wsi_image *
+wsi_fbdev_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain,
+                                  uint32_t image_index)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static VkResult
+wsi_fbdev_swapchain_release_images(struct wsi_swapchain *wsi_chain,
+                                   uint32_t count, const uint32_t *indices)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < count; i++)
+      chain->images[indices[i]].acquired = false;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                       const VkAcquireNextImageInfoKHR *info,
+                                       uint32_t *image_index)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+
+   /* Presentation copies synchronously, so every image the app is not
+    * holding is free. Rotate so the app does not reuse one image forever.
+    */
+   for (uint32_t n = 0; n < chain->base.image_count; n++) {
+      uint32_t i = (chain->page + 1 + n) % chain->base.image_count;
+      if (!chain->images[i].acquired) {
+         chain->images[i].acquired = true;
+         *image_index = i;
+         return VK_SUCCESS;
+      }
+   }
+   return info->timeout ? VK_TIMEOUT : VK_NOT_READY;
+}
+
+#define WSI_FBDEV_BLOCK 32
+
+static void
+wsi_fbdev_copy(struct wsi_fbdev_swapchain *chain, const struct wsi_image *image,
+               uint8_t *dst)
+{
+   bool swap = chain->rotation == 90 || chain->rotation == 270;
+   uint32_t lw = swap ? chain->var.yres : chain->var.xres;
+   uint32_t lh = swap ? chain->var.xres : chain->var.yres;
+   uint32_t w = MIN2(chain->extent.width, lw);
+   uint32_t h = MIN2(chain->extent.height, lh);
+   uint32_t ox = (lw - w) / 2;
+   uint32_t oy = (lh - h) / 2;
+   const uint8_t *src = (const uint8_t *)image->cpu_map + image->offsets[0];
+   uint32_t pitch = image->row_pitches[0];
+   uint32_t stride = chain->line_length / 4;
+
+   VkMappedMemoryRange range = {
+      .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+      .memory = image->blit.memory != VK_NULL_HANDLE ? image->blit.memory : image->memory,
+      .size = VK_WHOLE_SIZE,
+   };
+   chain->base.wsi->InvalidateMappedMemoryRanges(chain->base.device, 1, &range);
+
+   if (chain->rotation == 0) {
+      dst += oy * chain->line_length + ox * 4;
+      for (uint32_t y = 0; y < h; y++)
+         memcpy(dst + y * chain->line_length, src + y * pitch, w * 4);
+      return;
+   }
+
+   uint32_t *fb = (uint32_t *)dst;
+   if (chain->rotation == 180) {
+      for (uint32_t y = 0; y < h; y++) {
+         const uint32_t *row = (const uint32_t *)(src + y * pitch);
+         uint32_t *d = fb + (lh - 1 - (y + oy)) * stride + (lw - w - ox);
+         for (uint32_t x = 0; x < w; x++)
+            d[x] = row[w - 1 - x];
+      }
+      return;
+   }
+
+   /* Turn one block at a time inside L1, then write it out as runs of
+    * framebuffer rows.
+    */
+   uint32_t blk[WSI_FBDEV_BLOCK][WSI_FBDEV_BLOCK];
+   for (uint32_t by = 0; by < h; by += WSI_FBDEV_BLOCK) {
+      uint32_t ey = MIN2(by + WSI_FBDEV_BLOCK, h);
+      uint32_t n = ey - by;
+      for (uint32_t bx = 0; bx < w; bx += WSI_FBDEV_BLOCK) {
+         uint32_t ex = MIN2(bx + WSI_FBDEV_BLOCK, w);
+         for (uint32_t y = by; y < ey; y++) {
+            const uint32_t *row = (const uint32_t *)(src + y * pitch);
+            uint32_t i = chain->rotation == 90 ? y - by : ey - 1 - y;
+            for (uint32_t x = bx; x < ex; x++)
+               blk[x - bx][i] = row[x];
+         }
+         for (uint32_t x = bx; x < ex; x++) {
+            uint32_t *d = chain->rotation == 90 ?
+               fb + (lw - 1 - (x + ox)) * stride + (by + oy) :
+               fb + (x + ox) * stride + (lh - ey - oy);
+            memcpy(d, blk[x - bx], n * 4);
+         }
+      }
+   }
+}
+
+static VkResult
+wsi_fbdev_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
+                                  uint32_t image_index,
+                                  uint64_t present_id,
+                                  const VkPresentRegionKHR *damage)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+   uint32_t page_size = chain->var.yres * chain->line_length;
+   uint32_t page = chain->pages > 1 ? (chain->page + 1) % chain->pages : 0;
+
+   wsi_fbdev_copy(chain, &chain->images[image_index].base,
+                  chain->map + page * page_size);
+   chain->images[image_index].acquired = false;
+
+   if (chain->pages > 1) {
+      chain->var.yoffset = page * chain->var.yres;
+      ioctl(chain->fd, FBIOPAN_DISPLAY, &chain->var);
+   }
+   chain->page = page;
+
+   if (chain->base.present_mode == VK_PRESENT_MODE_FIFO_KHR) {
+      uint32_t crtc = 0;
+      ioctl(chain->fd, FBIO_WAITFORVSYNC, &crtc);
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain,
+                                     uint64_t waitValue,
+                                     uint64_t timeout)
+{
+   return wsi_swapchain_wait_for_present_semaphore(wsi_chain, waitValue, timeout);
+}
+
+static VkResult
+wsi_fbdev_swapchain_destroy(struct wsi_swapchain *wsi_chain,
+                            const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+
+   if (chain->map != MAP_FAILED && chain->map != NULL) {
+      if (chain->saved)
+         memcpy(chain->map, chain->saved, chain->map_size);
+      munmap(chain->map, chain->map_size);
+   }
+   free(chain->saved);
+   if (chain->fd >= 0) {
+      chain->var.yoffset = chain->orig_yoffset;
+      ioctl(chain->fd, FBIOPAN_DISPLAY, &chain->var);
+      close(chain->fd);
+   }
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      if (chain->images[i].base.image != VK_NULL_HANDLE)
+         wsi_destroy_image(&chain->base, &chain->images[i].base);
+   }
+
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_open(struct wsi_fbdev *wsi, struct wsi_fbdev_swapchain *chain)
+{
+   struct fb_fix_screeninfo fix;
+
+   chain->fd = open(wsi->path, O_RDWR | O_CLOEXEC);
+   if (chain->fd < 0)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   if (ioctl(chain->fd, FBIOGET_VSCREENINFO, &chain->var) != 0 ||
+       ioctl(chain->fd, FBIOGET_FSCREENINFO, &fix) != 0 ||
+       !wsi_fbdev_is_bgra8888(&chain->var))
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   chain->orig_yoffset = chain->var.yoffset;
+   chain->line_length = fix.line_length;
+   chain->pages = MAX2(1, MIN2(chain->var.yres_virtual / chain->var.yres, 2));
+   chain->page = chain->var.yoffset / chain->var.yres;
+   if (chain->page >= chain->pages)
+      chain->page = 0;
+   chain->var.xoffset = 0;
+
+   chain->map_size = (size_t)fix.line_length * chain->var.yres * chain->pages;
+   if (chain->map_size > fix.smem_len)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   chain->map = mmap(NULL, chain->map_size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                     chain->fd, 0);
+   if (chain->map == MAP_FAILED)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   chain->saved = malloc(chain->map_size);
+   if (chain->saved)
+      memcpy(chain->saved, chain->map, chain->map_size);
+   chain->rotation = wsi->rotation;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
+                                   VkDevice device,
+                                   struct wsi_device *wsi_device,
+                                   const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                   const VkAllocationCallbacks *pAllocator,
+                                   struct wsi_swapchain **swapchain_out)
+{
+   struct wsi_fbdev *wsi =
+      (struct wsi_fbdev *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+   struct wsi_fbdev_swapchain *chain;
+   VkResult result;
+
+   uint32_t num_images = MAX2(pCreateInfo->minImageCount, 2);
+   size_t size = sizeof(*chain) + num_images * sizeof(chain->images[0]);
+   chain = vk_zalloc(pAllocator, size, 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   chain->fd = -1;
+
+   struct wsi_cpu_image_params cpu_params = {
+      .base.image_type = WSI_IMAGE_TYPE_CPU,
+   };
+
+   result = wsi_swapchain_init(wsi_device, &chain->base, device,
+                               pCreateInfo, &cpu_params.base, pAllocator);
+   if (result != VK_SUCCESS) {
+      vk_free(pAllocator, chain);
+      return result;
+   }
+
+   chain->base.destroy = wsi_fbdev_swapchain_destroy;
+   chain->base.get_wsi_image = wsi_fbdev_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = wsi_fbdev_swapchain_acquire_next_image;
+   chain->base.release_images = wsi_fbdev_swapchain_release_images;
+   chain->base.queue_present = wsi_fbdev_swapchain_queue_present;
+   chain->base.wait_for_present = wsi_fbdev_swapchain_wait_for_present;
+   chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   chain->extent = pCreateInfo->imageExtent;
+
+   result = wsi_fbdev_open(wsi, chain);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   for (; chain->base.image_count < num_images; chain->base.image_count++) {
+      result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                &chain->images[chain->base.image_count].base);
+      if (result != VK_SUCCESS)
+         goto fail;
+   }
+
+   *swapchain_out = &chain->base;
+   return VK_SUCCESS;
+
+fail:
+   wsi_fbdev_swapchain_destroy(&chain->base, pAllocator);
+   return result;
+}
+
+VkResult
+wsi_display_init_wsi(struct wsi_device *wsi_device,
+                     const VkAllocationCallbacks *alloc,
+                     int display_fd)
+{
+   struct wsi_fbdev *wsi = vk_zalloc(alloc, sizeof(*wsi), 8,
+                                     VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!wsi)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   wsi->alloc = alloc;
+   wsi->path = getenv("MESA_VK_FBDEV");
+   if (!wsi->path)
+      wsi->path = "/dev/fb0";
+   wsi->rotation = wsi_fbdev_rotation();
+   wsi_fbdev_probe(wsi);
+
+   /* Presentation reads every frame on the CPU: use cached host memory and
+    * have the common code wait for rendering before queue_present.
+    */
+   wsi_device->sw = true;
+   wsi_device->sw_host_noncoherent = true;
+
+   wsi->base.get_support = wsi_fbdev_surface_get_support;
+   wsi->base.get_capabilities2 = wsi_fbdev_surface_get_capabilities2;
+   wsi->base.get_formats = wsi_fbdev_surface_get_formats;
+   wsi->base.get_formats2 = wsi_fbdev_surface_get_formats2;
+   wsi->base.get_present_modes = wsi_fbdev_surface_get_present_modes;
+   wsi->base.get_present_rectangles = wsi_fbdev_surface_get_present_rectangles;
+   wsi->base.create_swapchain = wsi_fbdev_surface_create_swapchain;
+
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY] = &wsi->base;
+   return VK_SUCCESS;
+}
+
+void
+wsi_display_finish_wsi(struct wsi_device *wsi_device,
+                       const VkAllocationCallbacks *alloc)
+{
+   vk_free(alloc, wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY]);
+}
