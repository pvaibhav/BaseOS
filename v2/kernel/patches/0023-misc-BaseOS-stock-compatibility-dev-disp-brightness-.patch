index 000000000..520c0374f
--- /dev/null
+++ b/drivers/misc/baseos-stock-compat.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Vendor-kernel interfaces that frontends written for the stock Anbernic
+ * firmware use directly, provided on top of the mainline drivers so those
+ * frontends run unchanged:
+ *  - /dev/disp: DISP_LCD_SET/GET_BRIGHTNESS (0..255) drive the panel backlight.
+ *  - the power key is input event0 (frontends wake from sleep on event0).
+ */
+#include <linux/backlight.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/miscdevice.h>
+#include <linux/platform_device.h>
+#include <linux/uaccess.h>
+
+#define DISP_LCD_SET_BRIGHTNESS	0x102
+#define DISP_LCD_GET_BRIGHTNESS	0x103
+
+static long disp_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct backlight_device *bd;
+	unsigned long args[4];
+	long ret;
+
+	if (cmd != DISP_LCD_SET_BRIGHTNESS && cmd != DISP_LCD_GET_BRIGHTNESS)
+		return -ENOTTY;
+	if (copy_from_user(args, (void __user *)arg, sizeof(args)))
+		return -EFAULT;
+	bd = backlight_device_get_by_name("backlight");
+	if (!bd)
+		return -ENODEV;
+	if (cmd == DISP_LCD_SET_BRIGHTNESS)
+		ret = backlight_device_set_brightness(bd,
+			DIV_ROUND_CLOSEST(min(args[1], 255UL) * bd->props.max_brightness, 255));
+	else
+		ret = DIV_ROUND_CLOSEST(bd->props.brightness * 255, bd->props.max_brightness);
+	put_device(&bd->dev);
+	return ret;
+}
+
+static const struct file_operations disp_fops = {
+	.owner = THIS_MODULE,
+	.unlocked_ioctl = disp_ioctl,
+	.compat_ioctl = compat_ptr_ioctl,
+};
+
+static struct miscdevice disp_dev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "disp",
+	.fops = &disp_fops,
+	.mode = 0666,
+};
+
+/* Input numbers follow registration order: register the power key first. */
+static void __init power_key_first(void)
+{
+	struct device *pek, *keys;
+
+	pek = bus_find_device_by_name(&platform_bus_type, NULL, "axp20x-pek");
+	keys = bus_find_device_by_name(&platform_bus_type, NULL, "gpio-keys");
+	if (pek && keys && pek->driver && keys->driver) {
+		device_release_driver(keys);
+		device_release_driver(pek);
+		if (device_attach(pek) <= 0)
+			pr_warn("baseos: power key did not rebind\n");
+		if (device_attach(keys) <= 0)
+			pr_warn("baseos: keys did not rebind\n");
+	}
+	put_device(pek);
+	put_device(keys);
+}
+
+static int __init baseos_stock_compat_init(void)
+{
+	if (!of_machine_is_compatible("allwinner,sun50i-h700"))
+		return 0;
+	power_key_first();
+	return misc_register(&disp_dev);
+}
+late_initcall_sync(baseos_stock_compat_init);
