+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/allwinner,sun50i-h616-de33-planes.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Allwinner H616 DE33 shared planes
+maintainers:
+  - Jernej Skrabec <jernej.skrabec@gmail.com>
+properties:
+  compatible:
+    const: allwinner,sun50i-h616-de33-planes
+  reg:
+    maxItems: 1
+  allwinner,plane-mapping:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: DE33 clock controller providing the plane mapping regmap.
+required:
+  - compatible
+  - reg
+  - allwinner,plane-mapping
+additionalProperties: false
