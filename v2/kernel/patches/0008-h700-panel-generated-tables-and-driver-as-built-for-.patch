--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-baseos-h700.c
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bootloader-derived SPI-DPI contract; no warm adoption or TCON programming. */
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/property.h>
+#include <linux/spi/spi.h>
+#include <drm/drm_mipi_dbi.h>
+#include <drm/drm_panel.h>
+#include <video/videomode.h>
+#include "h700-panel-tables.h"
+
+/* Largest parameter list in the pinned P1 data. DMA-safe in devm allocation. */
+#define H700_MAX_PARAMS 44
+struct h700_panel {
+	struct drm_panel panel;
+	struct mipi_dbi dbi;
+	const struct h700_panel_data *data;
+	const struct h700_stream *stream;
+	struct gpio_desc *reset, *power;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *active, *sleep;
+	s64 off_until_ns;
+	u8 params[H700_MAX_PARAMS];
+};
+
+static struct h700_panel *to_h700(struct drm_panel *panel)
+{
+	return container_of(panel, struct h700_panel, panel);
+}
+
+static int h700_stream_write(struct h700_panel *ctx)
+{
+	const struct h700_stream *s = ctx->stream;
+	unsigned int i, n = 0;
+	int cmd = -1, ret;
+
+	for (i = 0; i <= s->count; i++) {
+		u16 w = i == s->count ? 0x8000 : s->words[i];
+
+		if (w >= 0x100 && w <= 0x1ff) {
+			if (cmd < 0)
+				return -EINVAL;
+			if (n == H700_MAX_PARAMS)
+				return -E2BIG;
+			ctx->params[n++] = w & 0xff;
+			continue;
+		}
+		if (i != s->count && w > 0xff &&
+		    (w < 0x8001 || w > 0x83e8))
+			return -EINVAL;
+		if (cmd >= 0) {
+			ret = mipi_dbi_command_buf(&ctx->dbi, cmd, ctx->params, n);
+			if (ret)
+				return ret;
+		}
+		n = 0;
+		cmd = -1;
+		if (w <= 0xff)
+			cmd = w;
+		else if (i != s->count)
+			msleep(w - 0x8000);
+	}
+	return 0;
+}
+
+static int h700_unprepare(struct drm_panel *panel)
+{
+	struct h700_panel *ctx = to_h700(panel);
+	int ret = 0;
+
+	if (ctx->sleep)
+		ret = pinctrl_select_state(ctx->pinctrl, ctx->sleep);
+	if (ret)
+		dev_warn(panel->dev, "Failed to select sleep pins: %d\n", ret);
+	msleep(25);
+	ctx->off_until_ns = ktime_to_ns(ktime_get_boottime()) + 700 * NSEC_PER_MSEC;
+	/* Clear DRM's prepared state so the next prepare resets the panel. */
+	return 0;
+}
+
+static int h700_prepare(struct drm_panel *panel)
+{
+	struct h700_panel *ctx = to_h700(panel);
+	s64 remaining = ctx->off_until_ns - ktime_to_ns(ktime_get_boottime());
+	int ret, power;
+
+	if (remaining > 0)
+		msleep(DIV_ROUND_UP_ULL(remaining, NSEC_PER_MSEC));
+	ret = backlight_disable(panel->backlight);
+	if (ret)
+		return ret;
+	ret = pinctrl_select_state(ctx->pinctrl, ctx->active);
+	if (ret)
+		return ret;
+	power = gpiod_get_value_cansleep(ctx->power);
+	if (power < 0)
+		return power;
+	/* Set direction as well: GPIOD_ASIS at probe preserves loader latches. */
+	ret = gpiod_direction_output(ctx->power, 1);
+	if (ret < 0)
+		goto fail;
+	if (!power)
+		msleep(30);
+	/* Active-low logical 0/1/0 is physical high/low/high. */
+	ret = gpiod_direction_output(ctx->reset, 0);
+	if (ret)
+		goto fail;
+	msleep(15);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(50);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(100);
+	ret = h700_stream_write(ctx);
+	if (ret)
+		goto fail;
+	msleep(50);
+	return 0;
+fail:
+	/* No automatic retransmits. A later prepare performs the full reset. */
+	h700_unprepare(panel);
+	return ret;
+}
+
+static int h700_enable(struct drm_panel *panel)
+{
+	msleep(100);
+	return 0; /* Panel core enables backlight after this callback. */
+}
+
+static int h700_disable(struct drm_panel *panel)
+{
+	return 0; /* Panel core has already disabled backlight. No DCS exit. */
+}
+
+static int h700_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct h700_panel *ctx = to_h700(panel);
+	struct drm_display_mode *mode;
+	int ret;
+
+	ret = drm_display_info_set_bus_formats(&connector->display_info,
+					     &ctx->data->bus_format, 1);
+	if (ret)
+		return ret;
+	mode = drm_mode_duplicate(connector->dev, &ctx->data->mode);
+	if (!mode)
+		return -ENOMEM;
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	connector->display_info.bus_flags = ctx->data->bus_flags;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static enum drm_panel_orientation h700_orientation(struct drm_panel *panel)
+{
+	return DRM_MODE_PANEL_ORIENTATION_UNKNOWN;
+}
+
+static int h700_get_timings(struct drm_panel *panel, unsigned int count,
+			    struct display_timing *timings)
+{
+	struct h700_panel *ctx = to_h700(panel);
+	struct videomode vm;
+
+	if (!count || !timings)
+		return 1;
+	drm_display_mode_to_videomode(&ctx->data->mode, &vm);
+#define FIXED(field) .field = { vm.field, vm.field, vm.field }
+	*timings = (struct display_timing) {
+		FIXED(pixelclock), FIXED(hactive), FIXED(hfront_porch),
+		FIXED(hback_porch), FIXED(hsync_len), FIXED(vactive),
+		FIXED(vfront_porch), FIXED(vback_porch), FIXED(vsync_len),
+		.flags = vm.flags,
+	};
+#undef FIXED
+	return 1;
+}
+
+static const struct drm_panel_funcs h700_funcs = {
+	.prepare = h700_prepare, .enable = h700_enable,
+	.disable = h700_disable, .unprepare = h700_unprepare,
+	.get_modes = h700_get_modes, .get_orientation = h700_orientation,
+	.get_timings = h700_get_timings,
+};
+
+static int h700_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct h700_panel *ctx;
+	const char *variant;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct h700_panel, panel, &h700_funcs,
+				   DRM_MODE_CONNECTOR_DPI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	ctx->data = device_get_match_data(dev);
+	if (!ctx->data || device_property_present(dev, "baseos,panel-state") ||
+	    device_property_string_array_count(dev, "baseos,panel") != 1 ||
+	    device_property_read_string(dev, "baseos,panel", &variant))
+		return -ENODEV;
+	if (!strcmp(variant, "old"))
+		ctx->stream = ctx->data->old;
+	else if (!strcmp(variant, "boe"))
+		ctx->stream = ctx->data->boe;
+	if (!ctx->stream)
+		return -ENODEV;
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset))
+		return PTR_ERR(ctx->reset);
+	ctx->power = devm_gpiod_get(dev, "power", GPIOD_ASIS);
+	if (IS_ERR(ctx->power))
+		return PTR_ERR(ctx->power);
+	if (!gpiod_is_active_low(ctx->reset) || gpiod_is_active_low(ctx->power))
+		return -EINVAL;
+	ctx->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(ctx->pinctrl))
+		return PTR_ERR(ctx->pinctrl);
+	ctx->active = pinctrl_lookup_state(ctx->pinctrl, PINCTRL_STATE_DEFAULT);
+	if (IS_ERR(ctx->active))
+		return PTR_ERR(ctx->active);
+	if (device_property_match_string(dev, "pinctrl-names", "sleep") >= 0) {
+		ctx->sleep = pinctrl_lookup_state(ctx->pinctrl, PINCTRL_STATE_SLEEP);
+		if (IS_ERR(ctx->sleep))
+			return PTR_ERR(ctx->sleep);
+	}
+	/* Require native 9-bit writes; no emulation padding in vendor streams. */
+	if (!spi_is_bpw_supported(spi, 9))
+		return -EOPNOTSUPP;
+	ret = mipi_dbi_spi_init(spi, &ctx->dbi, NULL);
+	if (ret)
+		return ret;
+	ctx->dbi.read_commands = NULL;
+	ctx->dbi.write_memory_bpw = 8;
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return ret;
+	if (!ctx->panel.backlight)
+		return -ENODEV;
+	spi_set_drvdata(spi, ctx);
+	drm_panel_add(&ctx->panel);
+	return 0;
+}
+
+static void h700_remove(struct spi_device *spi)
+{
+	struct h700_panel *ctx = spi_get_drvdata(spi);
+
+	drm_panel_remove(&ctx->panel);
+}
