+};
+MODULE_DEVICE_TABLE(of, h700_of_match);
+static struct spi_driver h700_driver = {
+ .driver = { .name = "panel-baseos-h700", .of_match_table = h700_of_match },
+ .probe = h700_probe, .remove = h700_remove,
+};
+module_spi_driver(h700_driver);
