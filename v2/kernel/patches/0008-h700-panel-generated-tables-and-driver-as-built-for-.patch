+	{ .compatible = "baseos,rg34xx-panel", .data = &h700_panels[1] },
+	{ .compatible = "baseos,rg34xxsp-panel", .data = &h700_panels[2] },
+	{ .compatible = "baseos,rg35xxh-panel", .data = &h700_panels[3] },
+	{ .compatible = "baseos,rg35xxplus-panel", .data = &h700_panels[4] },
+	{ .compatible = "baseos,rg35xxpro-panel", .data = &h700_panels[5] },
+	{ .compatible = "baseos,rg35xxsp-panel", .data = &h700_panels[6] },
+	{ .compatible = "baseos,rg40xxh-panel", .data = &h700_panels[7] },
+	{ .compatible = "baseos,rg40xxv-panel", .data = &h700_panels[8] },
+	{ .compatible = "baseos,rgcubexx-panel", .data = &h700_panels[9] },
+	{ .compatible = "baseos,rgsp-panel", .data = &h700_panels[10] },
