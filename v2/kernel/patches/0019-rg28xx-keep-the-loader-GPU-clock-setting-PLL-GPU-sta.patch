From 466012ec47f7159e0b4001da0b2b64d68beaa4f1 Mon Sep 17 00:00:00 2001
From: Prashant Vaibhav <prashant@vaibhav.de>
Date: Sat, 31 Oct 2026 11:36:16 +0000
Subject: [PATCH 19/41] rg28xx: keep the loader GPU clock (setting PLL-GPU
 stalls probe 75 ms)

---
 .../boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts  | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
index 3db01448f..96d9a8e73 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
@@ -183,9 +183,6 @@ &mmc0 {
 /* Frequency-only: dedicated PLL, no OPP table or PMIC control. */
 &gpu {
     mali-supply = <&reg_gpu_sys_retained>;
-    assigned-clocks = <&ccu BASEOS_H616_PLL_GPU>, <&ccu CLK_GPU0>;
-    assigned-clock-parents = <0>, <&ccu BASEOS_H616_PLL_GPU>;
-    assigned-clock-rates = <420000000>, <420000000>;
     status = "okay";
 };
 / {
