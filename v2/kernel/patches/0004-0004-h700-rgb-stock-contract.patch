+
 	tcon->clk = devm_clk_get_enabled(dev, "ahb");
 	if (IS_ERR(tcon->clk)) {
 		dev_err(dev, "Couldn't get the TCON bus clock\n");
@@ -1295,6 +1352,8 @@ static int sun4i_tcon_bind(struct device *dev, struct device *master,
 	if (tcon->quirks->has_channel_0)
 		sun4i_dclk_free(tcon);
 err_assert_reset:
+	if (tcon->quirks->h700_rgb)
+		sun4i_h700_fini_clocks(tcon);
 	reset_control_assert(tcon->lcd_rst);
 	return ret;
 }
@@ -1307,6 +1366,8 @@ static void sun4i_tcon_unbind(struct device *dev, struct device *master,
 	list_del(&tcon->list);
 	if (tcon->quirks->has_channel_0)
 		sun4i_dclk_free(tcon);
+	if (tcon->quirks->h700_rgb)
+		sun4i_h700_fini_clocks(tcon);
 }
 
 static const struct component_ops sun4i_tcon_ops = {
@@ -1555,7 +1616,15 @@ static const struct sun4i_tcon_quirks sun20i_d1_lcd_quirks = {
 };
 
 /* sun4i_drv uses this list to check if a device node is a TCON */
