+	bool h700_pll_owned, h700_sclk_owned;
+	bool h700_bus_enabled, h700_channel_enabled;
+	u32 h700_dclk_sel;
+
 	/* Pixel clock */
 	struct clk			*dclk;
 	u8				dclk_max_div;
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon_dclk.c b/drivers/gpu/drm/sun4i/sun4i_tcon_dclk.c
index 4afb12bd5..043fd67ae 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon_dclk.c
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon_dclk.c
@@ -6,6 +6,7 @@
  * Maxime Ripard <maxime.ripard@free-electrons.com>
  */
 
+#include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/regmap.h>
 
@@ -67,6 +68,67 @@ static unsigned long sun4i_dclk_recalc_rate(struct clk_hw *hw,
 	return parent_rate / val;
 }
 
+/* This claim belongs to component bind, not the platform device lifetime. */
+static void sun4i_h700_clock_release(struct sun4i_tcon *tcon)
+{
+	if (tcon->h700_sclk_owned) {
+		clk_rate_exclusive_put(tcon->sclk0);
+		tcon->h700_sclk_owned = false;
+	}
+	if (tcon->h700_pll_owned) {
+		clk_rate_exclusive_put(tcon->h700_pll);
+		tcon->h700_pll_owned = false;
+	}
+	if (tcon->h700_pll) {
+		clk_put(tcon->h700_pll);
+		tcon->h700_pll = NULL;
+	}
+}
+
+static int sun4i_h700_clock_claim(struct device *dev, struct sun4i_tcon *tcon)
+{
+	struct clk_hw *mux = __clk_get_hw(tcon->sclk0);
+	int ret;
+
+	if (of_property_count_u32_elems(dev->of_node, "allwinner,dclk-sel") != 1 ||
+	    of_property_read_u32(dev->of_node, "allwinner,dclk-sel", &tcon->h700_dclk_sel) ||
+	    (tcon->h700_dclk_sel != 0 && tcon->h700_dclk_sel != 2))
+		return -EINVAL;
+	tcon->h700_pll = clk_get(dev, "pll-video0-4x");
+	if (IS_ERR(tcon->h700_pll)) {
+		ret = PTR_ERR(tcon->h700_pll);
+		tcon->h700_pll = NULL;
+		return ret;
+	}
+	/* CCU 0xb60 source 1 must be the explicit PLL_VIDEO0_4X input. */
+	if (clk_hw_get_parent_by_index(mux, 1) != __clk_get_hw(tcon->h700_pll)) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	ret = clk_set_rate_exclusive(tcon->h700_pll, 288000000);
+	if (ret)
+		goto fail;
+	tcon->h700_pll_owned = true;
+	ret = clk_set_parent(tcon->sclk0, tcon->h700_pll);
+	if (ret)
+		goto fail;
+	ret = clk_rate_exclusive_get(tcon->sclk0);
+	if (ret)
+		goto fail;
+	tcon->h700_sclk_owned = true;
+	if (clk_get_rate(tcon->sclk0) != 288000000) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	ret = regmap_update_bits(tcon->regs, SUN4I_TCON0_IO_POL_REG,
+			  GENMASK(29, 28), tcon->h700_dclk_sel << 28);
+	if (!ret)
+		return 0;
+fail:
+	sun4i_h700_clock_release(tcon);
+	return ret;
+}
+
 static int sun4i_dclk_determine_rate(struct clk_hw *hw,
 				     struct clk_rate_request *req)
 {
@@ -76,6 +138,27 @@ static int sun4i_dclk_determine_rate(struct clk_hw *hw,
 	u8 best_div = 1;
 	int i;
 
+	if (tcon->quirks->h700_rgb) {
+		unsigned long delta = ULONG_MAX;
+		if (clk_hw_get_rate(clk_hw_get_parent(hw)) != 288000000 || !req->rate)
+			return -EINVAL;
+		for (i = tcon->dclk_min_div; i <= tcon->dclk_max_div; i++) {
+			unsigned long rate = 288000000 / i;
+			unsigned long diff = rate > req->rate ? rate - req->rate : req->rate - rate;
+			if (rate < req->min_rate || rate > req->max_rate)
+				continue;
+			if (diff < delta) {
+				delta = diff;
+				best_div = i;
+			}
+		}
+		if (delta == ULONG_MAX)
+			return -EINVAL;
+		req->best_parent_rate = 288000000;
+		req->rate = 288000000 / best_div;
+		return 0;
+	}
+
 	for (i = tcon->dclk_min_div; i <= tcon->dclk_max_div; i++) {
 		u64 ideal = (u64)req->rate * i;
 		unsigned long rounded;
@@ -118,7 +201,22 @@ static int sun4i_dclk_set_rate(struct clk_hw *hw, unsigned long rate,
 			       unsigned long parent_rate)
 {
 	struct sun4i_dclk *dclk = hw_to_dclk(hw);
-	u8 div = parent_rate / rate;
+	u8 div;
+
+	if (dclk->tcon->quirks->h700_rgb) {
+		unsigned int i;
+		if (!rate || parent_rate != 288000000)
+			return -EINVAL;
+		/* determine_rate returned the floor of parent/div, not the kHz request. */
+		for (i = dclk->tcon->dclk_min_div; i <= dclk->tcon->dclk_max_div; i++)
+			if (parent_rate / i == rate)
+				break;
+		if (i > dclk->tcon->dclk_max_div)
+			return -EINVAL;
+		div = i;
+	} else {
+		div = parent_rate / rate;
+	}
 
 	return regmap_update_bits(dclk->regmap, SUN4I_TCON0_DCLK_REG,
 				  GENMASK(6, 0), div);
@@ -187,14 +285,25 @@ int sun4i_dclk_create(struct device *dev, struct sun4i_tcon *tcon)
 	init.ops = &sun4i_dclk_ops;
 	init.parent_names = &parent_name;
 	init.num_parents = 1;
-	init.flags = CLK_SET_RATE_PARENT;
+	init.flags = tcon->quirks->h700_rgb ? 0 : CLK_SET_RATE_PARENT;
 
 	dclk->regmap = tcon->regs;
 	dclk->hw.init = &init;
 
+	if (tcon->quirks->h700_rgb) {
+		/* CCF may validate a mode before the first modeset initializes these. */
+		tcon->dclk_min_div = tcon->quirks->dclk_min_div;
+		tcon->dclk_max_div = 127;
+		ret = sun4i_h700_clock_claim(dev, tcon);
+		if (ret)
+			return ret;
+	}
+
 	tcon->dclk = clk_register(dev, &dclk->hw);
-	if (IS_ERR(tcon->dclk))
+	if (IS_ERR(tcon->dclk)) {
+		sun4i_h700_clock_release(tcon);
 		return PTR_ERR(tcon->dclk);
+	}
 
 	return 0;
 }
@@ -203,6 +312,7 @@ EXPORT_SYMBOL(sun4i_dclk_create);
 int sun4i_dclk_free(struct sun4i_tcon *tcon)
 {
 	clk_unregister(tcon->dclk);
+	sun4i_h700_clock_release(tcon);
 	return 0;
 }
 EXPORT_SYMBOL(sun4i_dclk_free);
