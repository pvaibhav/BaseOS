+static void sun4i_h700_fini_clocks(struct sun4i_tcon *tcon)
+{
+	if (tcon->h700_channel_enabled) {
+		clk_disable_unprepare(tcon->sclk0);
+		tcon->h700_channel_enabled = false;
+	}
+	if (!IS_ERR_OR_NULL(tcon->sclk0)) {
+		clk_put(tcon->sclk0);
+		tcon->sclk0 = NULL;
+	}
+	if (tcon->h700_bus_enabled) {
+		clk_disable_unprepare(tcon->clk);
+		tcon->h700_bus_enabled = false;
+	}
+	if (!IS_ERR_OR_NULL(tcon->clk)) {
+		clk_put(tcon->clk);
+		tcon->clk = NULL;
+	}
+}
+
+static int sun4i_h700_init_clocks(struct device *dev, struct sun4i_tcon *tcon)
+{
+	int ret;
+	tcon->clk = clk_get(dev, "ahb");
+	if (IS_ERR(tcon->clk)) {
+		ret = PTR_ERR(tcon->clk);
+		goto fail;
+	}
+	ret = clk_prepare_enable(tcon->clk);
+	if (ret)
+		goto fail;
+	tcon->h700_bus_enabled = true;
+	tcon->sclk0 = clk_get(dev, "tcon-ch0");
+	if (IS_ERR(tcon->sclk0)) {
+		ret = PTR_ERR(tcon->sclk0);
+		goto fail;
+	}
+	ret = clk_prepare_enable(tcon->sclk0);
+	if (ret)
+		goto fail;
+	tcon->h700_channel_enabled = true;
+	return 0;
+fail:
+	sun4i_h700_fini_clocks(tcon);
+	return ret;
+}
+
 static int sun4i_tcon_init_clocks(struct device *dev,
 				  struct sun4i_tcon *tcon)
 {
+	if (tcon->quirks->h700_rgb)
