 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_bridge.h>
@@ -64,6 +65,32 @@ static int sun4i_rgb_get_modes(struct drm_connector *connector)
  */
 #define SUN4I_RGB_DOTCLOCK_TOLERANCE_PER_MILLE	5
 
+/* Advertising one mode alone does not reject userspace-created modes. */
+static enum drm_mode_status sun4i_h700_rgb_mode_valid(struct sun4i_rgb *rgb,
+                         const struct drm_display_mode *mode)
+{
+	struct display_timing timing;
+	struct drm_display_mode fixed = { 0 };
+	struct videomode vm;
+	unsigned long divider;
+	long rounded;
+
+	if (!rgb->panel || !rgb->panel->funcs->get_timings ||
+     rgb->panel->funcs->get_timings(rgb->panel, 1, &timing) != 1)
+		return MODE_BAD;
+	videomode_from_timing(&timing, &vm);
+	drm_display_mode_from_videomode(&vm, &fixed);
+	if (mode->clock <= 0 || mode->clock != fixed.clock ||
+     !drm_mode_equal(mode, &fixed))
+		return MODE_BAD;
+	divider = DIV_ROUND_CLOSEST(288000000UL, fixed.clock * 1000UL);
+	if (divider < 1 || divider > 127)
+		return MODE_CLOCK_RANGE;
+	rounded = clk_round_rate(rgb->tcon->dclk, fixed.clock * 1000UL);
+	return rounded > 0 && rounded == 288000000UL / divider ?
+		MODE_OK : MODE_CLOCK_RANGE;
+}
+
 static enum drm_mode_status sun4i_rgb_mode_valid(struct drm_encoder *crtc,
 						 const struct drm_display_mode *mode)
 {
@@ -77,6 +104,9 @@ static enum drm_mode_status sun4i_rgb_mode_valid(struct drm_encoder *crtc,
 
