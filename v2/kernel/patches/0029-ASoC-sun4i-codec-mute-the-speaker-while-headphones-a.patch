From e842bd91bb406f7350468b096f982b992fb0852c Mon Sep 17 00:00:00 2001
From: Prashant Vaibhav <prashant@vaibhav.de>
Date: Sat, 31 Oct 2026 15:04:54 +0000
Subject: [PATCH 29/35] ASoC: sun4i-codec: mute the speaker while headphones
 are plugged in

---
 sound/soc/sunxi/sun4i-codec.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/sound/soc/sunxi/sun4i-codec.c b/sound/soc/sunxi/sun4i-codec.c
index ff56700a9..63c1522bb 100644
--- a/sound/soc/sunxi/sun4i-codec.c
+++ b/sound/soc/sunxi/sun4i-codec.c
@@ -1589,6 +1589,8 @@ static struct snd_soc_jack sun4i_headphone_jack;
 
 static struct snd_soc_jack_pin sun4i_headphone_jack_pins[] = {
 	{ .pin = "Headphone", .mask = SND_JACK_HEADPHONE },
+	/* Speaker and headphones share the line output: mute the speaker. */
+	{ .pin = "Speaker", .mask = SND_JACK_HEADPHONE, .invert = 1 },
 };
 
 static struct snd_soc_jack_gpio sun4i_headphone_jack_gpio = {
