From 7793615c65121bfdb5df473cb21d00575f292604 Mon Sep 17 00:00:00 2001
From: Prashant Vaibhav <prashant@vaibhav.de>
Date: Sat, 31 Oct 2026 10:34:39 +0000
Subject: [PATCH 12/17] of: BaseOS board overlay for nodes the boot firmware
 refuses (RG28XX PMIC, battery, CPU supply, audio)

---
 arch/arm64/boot/dts/allwinner/Makefile        |  1 +
 .../sun50i-h700-anbernic-rg28xx-baseos.dts    |  1 +
 drivers/of/Kconfig                            |  7 ++
 drivers/of/Makefile                           |  1 +
 drivers/of/baseos-overlay.c                   | 24 +++++
 drivers/of/baseos-rg28xx.dtso                 | 91 +++++++++++++++++++
 6 files changed, 125 insertions(+)
 create mode 100644 drivers/of/baseos-overlay.c
 create mode 100644 drivers/of/baseos-rg28xx.dtso

diff --git a/arch/arm64/boot/dts/allwinner/Makefile b/arch/arm64/boot/dts/allwinner/Makefile
index c16878df3..1b4ff9331 100644
--- a/arch/arm64/boot/dts/allwinner/Makefile
+++ b/arch/arm64/boot/dts/allwinner/Makefile
@@ -1,3 +1,4 @@
+DTC_FLAGS_sun50i-h700-anbernic-rg28xx-baseos := -@
 # SPDX-License-Identifier: GPL-2.0
 # Enables support for device-tree overlays for named devices
 DTC_FLAGS_sun50i-a64-pine64-lts := -@
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
index e6b817e66..b33abe799 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
 /dts-v1/;
 #include "sun50i-h616.dtsi"
+#include "sun50i-h616-cpu-opp.dtsi"
 #include <dt-bindings/gpio/gpio.h>
 /* Pinned 7.3.1 CCU onecell index; private header, not a stable binding ID. */
 #define BASEOS_H616_PLL_GPU 8
diff --git a/drivers/of/Kconfig b/drivers/of/Kconfig
index 50697cc3b..e8f57b3d3 100644
--- a/drivers/of/Kconfig
+++ b/drivers/of/Kconfig
@@ -126,4 +126,11 @@ config OF_OVERLAY_KUNIT_TEST
 config OF_NUMA
 	bool
 
+config BASEOS_BOARD_OVERLAY
