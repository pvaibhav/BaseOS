From ed8dbc9a142df5d17d4f44642608630af7dfec7d Mon Sep 17 00:00:00 2001
From: Prashant Vaibhav <prashant@vaibhav.de>
Date: Sat, 31 Oct 2026 11:12:56 +0000
Subject: [PATCH 17/20] rg28xx: drop ramoops (RAM does not survive this
 firmware restart)

---
 .../allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts   | 10 ----------
 1 file changed, 10 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
index 1251e5c55..3db01448f 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg28xx-baseos.dts
@@ -266,15 +266,5 @@ &tcon_lcd0 {
 
 &watchdog { timeout-sec = <4>; };
 
-/* Kernel log kept across resets (read at /sys/fs/pstore after the next boot). */
-&{/reserved-memory} {
-	ramoops@7f000000 {
-		compatible = "ramoops";
-		reg = <0x0 0x7f000000 0x0 0x100000>;
-		console-size = <0x80000>;
-		record-size = <0x40000>;
-		pmsg-size = <0x40000>;
-	};
-};
 
 #include "sun50i-h700-anbernic-rg28xx-phandles.dtsi"
