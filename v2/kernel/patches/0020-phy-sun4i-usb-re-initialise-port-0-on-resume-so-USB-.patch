From 7e7d7f16fb36d3b9adc89f73f6621d5df95b8655 Mon Sep 17 00:00:00 2001
From: Prashant Vaibhav <prashant@vaibhav.de>
Date: Sat, 31 Oct 2026 11:48:59 +0000
Subject: [PATCH 20/40] phy: sun4i-usb: re-initialise port 0 on resume so USB
 reconnects

---
 drivers/phy/allwinner/phy-sun4i-usb.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/phy/allwinner/phy-sun4i-usb.c b/drivers/phy/allwinner/phy-sun4i-usb.c
index 839856c09..eecaecda4 100644
--- a/drivers/phy/allwinner/phy-sun4i-usb.c
+++ b/drivers/phy/allwinner/phy-sun4i-usb.c
@@ -1035,12 +1035,31 @@ static const struct of_device_id sun4i_usb_phy_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, sun4i_usb_phy_of_match);
 
+/*
+ * Port 0 loses its forced ID/VBUS state and tuning during system sleep and
+ * the controller then never reconnects: run its exit/init again on resume.
+ */
+static int sun4i_usb_phy_resume(struct device *dev)
+{
+	struct sun4i_usb_phy_data *data = dev_get_drvdata(dev);
+	struct phy *phy0 = data->phys[0].phy;
+	int ret;
+
+	if (!data->phy0_init || !phy0)
+		return 0;
+	ret = sun4i_usb_phy_exit(phy0);
+	return ret ?: sun4i_usb_phy_init(phy0);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sun4i_usb_phy_pm_ops, NULL, sun4i_usb_phy_resume);
+
 static struct platform_driver sun4i_usb_phy_driver = {
 	.probe = sun4i_usb_phy_probe,
 	.remove = sun4i_usb_phy_remove,
 	.driver = {
 		.of_match_table= sun4i_usb_phy_of_match,
 		.name = "sun4i-usb-phy",
+		.pm = pm_sleep_ptr(&sun4i_usb_phy_pm_ops),
 	}
 };
 module_platform_driver(sun4i_usb_phy_driver);
