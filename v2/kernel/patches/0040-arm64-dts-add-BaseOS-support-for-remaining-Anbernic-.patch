diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg34xxsp-baseos.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg34xxsp-baseos.dts
new file mode 100644
index 000000000..46029972e
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg34xxsp-baseos.dts
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Build-only board support: untested on hardware. */
+#include "sun50i-h700-anbernic-baseos-radio.dtsi"
+#include "sun50i-h700-anbernic-baseos-sticks.dtsi"
+/ {
+    model = "BaseOS RG34XX SP";
+    compatible = "anbernic,rg34xxsp", "allwinner,sun50i-h700";
+    chosen { framebuffer@0 { width = <720>; height = <480>; stride = <2880>; }; };
+    gpio-keys-lid {
+        compatible = "gpio-keys";
+        /* The pull-up comes with the GPIO flags: a pinctrl claim on PE7 as
+         * well made the GPIO request fail. */
+        lid-switch {
+            label = "Lid Switch";
+            gpios = <&pio 4 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+            linux,input-type = <EV_SW>;
+            linux,code = <SW_LID>;
+            wakeup-source;
+            wakeup-event-action = <EV_ACT_DEASSERTED>;
+        };
+    };
+
+};
+&panel { compatible = "baseos,rg34xxsp-panel"; baseos,panel = "old"; };
+&tcon_lcd0 { allwinner,dclk-sel = <2>; };
+&axis_x { abs-range = <4096 0>; };
+&axis_y { abs-range = <4096 0>; };
+&axis_rx { abs-range = <4096 0>; };
+&axis_ry { abs-range = <4096 0>; };
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xxh-baseos.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xxh-baseos.dts
new file mode 100644
index 000000000..c9ac9559e
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xxh-baseos.dts
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Build-only board support: untested on hardware. */
+#include "sun50i-h700-anbernic-baseos-radio.dtsi"
+#include "sun50i-h700-anbernic-baseos-sticks.dtsi"
+/ {
+    model = "BaseOS RG35XX H";
+    compatible = "anbernic,rg35xxh", "allwinner,sun50i-h700";
+    chosen { framebuffer@0 { width = <640>; height = <480>; stride = <2560>; }; };
+};
+&panel { compatible = "baseos,rg35xxh-panel"; baseos,panel = "old"; };
+&tcon_lcd0 { allwinner,dclk-sel = <0>; };
+&wifi_pwrseq { reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>; post-power-on-delay-ms = <200>; };
+&axis_x { abs-range = <4096 0>; };
+&axis_y { abs-range = <0 4096>; };
+&axis_rx { abs-range = <0 4096>; };
+&axis_ry { abs-range = <4096 0>; };
+
+/* Separate USB host connector: upstream H PE5 -> PI7 power chain. */
+/ {
+	reg_vcc3v8_usb: regulator-vcc3v8-usb {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&pio 4 5 GPIO_ACTIVE_HIGH>; /* PE5 */
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+		regulator-name = "vcc3v8-usb";
+	};
+
+	reg_vcc5v0_usb: regulator-vcc5v0-usb {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&pio 8 7 GPIO_ACTIVE_HIGH>; /* PI7 */
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-name = "vcc5v0-usb";
+		vin-supply = <&reg_vcc3v8_usb>;
+	};
+};
+&ehci1 { status = "okay"; };
+&ohci1 { status = "okay"; };
+&usbphy { usb1_vbus-supply = <&reg_vcc5v0_usb>; };
