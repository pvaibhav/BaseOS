diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-baseos-radio.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-baseos-radio.dtsi
new file mode 100644
index 000000000..f596cb35c
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-baseos-radio.dtsi
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Keep the loader's display phandles and the stock input layout. */
+#include "sun50i-h700-anbernic-rg28xx-baseos.dts"
+#include <dt-bindings/input/gpio-keys.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+    vibrator {
+        compatible = "gpio-vibrator";
+        enable-gpios = <&pio 7 2 GPIO_ACTIVE_HIGH>;
+    };
+
+    leds {
+        compatible = "gpio-leds";
+        led-power {
+            function = LED_FUNCTION_POWER;
+            color = <LED_COLOR_ID_GREEN>;
+            gpios = <&pio 8 12 GPIO_ACTIVE_HIGH>;
+            default-state = "keep";
+        };
+        led-status {
+            function = LED_FUNCTION_STATUS;
+            color = <LED_COLOR_ID_GREEN>;
+            gpios = <&pio 8 11 GPIO_ACTIVE_HIGH>;
+            default-state = "keep";
+        };
+    };
+
+    wifi_pwrseq: wifi-pwrseq {
+        compatible = "mmc-pwrseq-simple";
+        clocks = <&rtc CLK_OSC32K_FANOUT>;
+        clock-names = "ext_clock";
+        pinctrl-names = "default";
+        pinctrl-0 = <&x32clk_fanout_pin>;
+        /* CLDO4 radio supply; boards with PG18 reset override this node. */
+    };
+
+    reg_tf2: regulator-tf2 {
+        compatible = "regulator-fixed";
+        regulator-name = "tf2-power";
+        regulator-min-microvolt = <3300000>;
+        regulator-max-microvolt = <3300000>;
+        vin-supply = <&reg_sd_boot>;
+        gpio = <&pio 4 4 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+        startup-delay-us = <1000>;
+    };
+};
+
+&pio {
+    tf2_pins: tf2-pins {
+        pins = "PC5", "PC6", "PC8", "PC10", "PC13", "PC15";
+        function = "mmc2";
+        drive-strength = <30>;
+        bias-pull-up;
+    };
+};
+
+&mmc1 {
+    mmc-pwrseq = <&wifi_pwrseq>;
+    bus-width = <4>;
+    max-frequency = <50000000>;
+    non-removable;
+    no-mmc;
+    no-sd;
+    keep-power-in-suspend;
+    status = "okay";
+};
+
+&mmc2 {
+    pinctrl-0 = <&tf2_pins>;
+    vmmc-supply = <&reg_tf2>;
+    bus-width = <4>;
+    max-frequency = <50000000>;
+    cd-gpios = <&pio 4 22 GPIO_ACTIVE_LOW>;
+    no-mmc;
+    no-sdio;
+    no-1-8-v;
+    /delete-property/ mmc-ddr-3_3v;
+    /delete-property/ cap-mmc-highspeed;
+    status = "okay";
+};
+
+&uart1 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
+    uart-has-rtscts;
+    status = "okay";
+    bluetooth {
+        compatible = "realtek,rtl8821cs-bt", "realtek,rtl8723bs-bt";
+        enable-gpios = <&pio 6 19 GPIO_ACTIVE_HIGH>;
+        device-wake-gpios = <&pio 6 17 GPIO_ACTIVE_HIGH>;
+        host-wake-gpios = <&pio 6 16 GPIO_ACTIVE_HIGH>;
+    };
+};
+
+/* Stock declares a PCF8563 on these boards; make it the persistent RTC.
+ * No external alarm IRQ wiring is established. The SoC RTC supplies clocks.
+ */
+&r_i2c {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    rtc_ext: rtc@51 {
+        compatible = "nxp,pcf8563";
+        reg = <0x51>;
+    };
+};
+
+/ {
+    aliases {
+        rtc0 = &rtc_ext;
+        rtc1 = &rtc;
+    };
+};
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-baseos-sticks.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-baseos-sticks.dtsi
new file mode 100644
index 000000000..8ac849d0b
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-baseos-sticks.dtsi
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* ADC/mux wiring from the upstream RG35XX H.
+ * Copyright (C) 2024 Ryan Walklin <ryan@testtoast.com>.
+ * Copyright (C) 2024 Chris Morgan <macroalpha82@gmail.com>.
+ */
+/ {
+	adc-joystick {
+		compatible = "adc-joystick";
+		io-channels = <&adc_mux 0>,
+			      <&adc_mux 1>,
+			      <&adc_mux 2>,
+			      <&adc_mux 3>;
+		poll-interval = <16>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		axis_x: axis@0 {
+			reg = <0>;
+			abs-flat = <32>;
+			abs-fuzz = <32>;
+			abs-range = <4096 0>;
+			linux,code = <ABS_X>;
+		};
+
+		axis_y: axis@1 {
+			reg = <1>;
+			abs-flat = <32>;
+			abs-fuzz = <32>;
+			abs-range = <0 4096>;
+			linux,code = <ABS_Y>;
+		};
+
+		axis_rx: axis@2 {
+			reg = <2>;
+			abs-flat = <32>;
+			abs-fuzz = <32>;
+			abs-range = <0 4096>;
+			linux,code = <ABS_RX>;
+		};
+
+		axis_ry: axis@3 {
+			reg = <3>;
+			abs-flat = <32>;
+			abs-fuzz = <32>;
+			abs-range = <4096 0>;
+			linux,code = <ABS_RY>;
+		};
+	};
+
+	adc_mux: adc-mux {
+		compatible = "io-channel-mux";
+		channels = "left_x", "left_y", "right_x", "right_y";
+		#io-channel-cells = <1>;
+		io-channels = <&gpadc 0>;
+		io-channel-names = "parent";
+		mux-controls = <&gpio_mux>;
+		settle-time-us = <100>;
+	};
+
+	gpio_mux: mux-controller {
+		compatible = "gpio-mux";
+		mux-gpios = <&pio 8 1 GPIO_ACTIVE_LOW>,
+			    <&pio 8 2 GPIO_ACTIVE_LOW>;
+		#mux-control-cells = <0>;
+	};
+
+};
+
+&gpadc {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    status = "okay";
+    channel@0 { reg = <0>; };
+};
+&pio {
+    /* Stock amux-en-gpios: PI0 output high, shared by all analog boards. */
+    joystick-enable { gpio-hog; gpios = <8 0 GPIO_ACTIVE_HIGH>; output-high; line-name = "joystick-mux-enable"; };
+};
+&{/gpio-keys} {
+    key-l3 { gpios = <&pio 4 8 17>; linux,code = <0x139>; };
+    key-r3 { gpios = <&pio 4 9 17>; linux,code = <0x13c>; };
+};
