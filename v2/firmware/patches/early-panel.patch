+/* Send stream entries up to the next vendor delay, then nothing until it has passed.
+ * Entries: command 0..0xff, data 0x100..0x1ff, delay 0x8000 | ms. After the last
+ * entry the vendor waits 50 ms before the TCON is enabled; the helper does that. */
+static void panel_stream(void)
+{
+    while (panel_sequence.step == 5 && panel_sequence.next < panel_sequence.count) {
+        u64 now;
+        asm volatile("isb; mrs %0, cntpct_el0" : "=r"(now));
+        if (now - panel_sequence.since < panel_sequence.wait)
+            return;
+        unsigned int op = panel_sequence.stream[panel_sequence.next++];
+        if (op & 0x8000u) {
+            panel_sequence.since = panel_mark();
+            panel_sequence.wait = (u64)(op & 0x7fffu) * BASEOS_PANEL_TICKS_PER_MS;
+        } else {
+            baseos_panel_spi9_send(&panel_sequence.port, (u8)op, op & 0x100u);
+        }
+        if (panel_sequence.next == panel_sequence.count) {
+            panel_sequence.since = panel_mark();
+            panel_sequence.wait = 50ull * BASEOS_PANEL_TICKS_PER_MS;
+        }
+    }
+}
