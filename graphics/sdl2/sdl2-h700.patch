+/* H700 (Anbernic RG XX) built-in pad. "ANBERNIC-keys" numbers its buttons
+   sequentially from 304 whatever their Linux meaning (314 is BTN_SELECT in
+   input.h but L2 here), and which codes exist depends on the model. Give it one
+   fixed layout on every model, matching TrimUI "Player1" and Xbox 360 raw
+   indices, under a tagged GUID so that mappings written for the old ascending
+   layout cannot match. SDL_JOYSTICK_H700_FIXED_LAYOUT=0 restores that layout. */
+#define H700_KEY_L2   314
+#define H700_KEY_R2   315
+#define H700_NBUTTONS 15 /* 11 and 12 are reserved and never fire */
+/* Tagged by IsJoystick(). Pads without vendor or product IDs get a name-only GUID,
+   where byte 14 is a letter of the name but byte 15 is always 0. */
+#define H700_IS_BUILTIN(joystick) \
+    ((joystick)->hwdata->guid.data[14] == 'n' && (joystick)->hwdata->guid.data[15] == 1)
+
+enum
+{
+    H700_AXIS_LX,
+    H700_AXIS_LY,
+    H700_AXIS_LT, /* synthesised from H700_KEY_L2 */
+    H700_AXIS_RX,
+    H700_AXIS_RY,
+    H700_AXIS_RT, /* synthesised from H700_KEY_R2 */
+    H700_NAXES
+};
+
+static const struct
+{
+    int code;
+    Uint8 index;
+} h700_buttons[] = {
+    { 305, 0 },  /* B (south) */
+    { 304, 1 },  /* A (east) */
+    { 306, 2 },  /* Y (west) */
+    { 307, 3 },  /* X (north) */
+    { 308, 4 },  /* L1 */
+    { 309, 5 },  /* R1 */
+    { 310, 6 },  /* SELECT */
+    { 311, 7 },  /* START */
+    { 312, 8 },  /* MENU */
+    { 313, 9 },  /* L3 */
+    { 316, 10 }, /* R3 */
+    { 114, 13 }, /* VOL- */
+    { 115, 14 }, /* VOL+ */
+}, h700_axes[] = {
+    { ABS_Z, H700_AXIS_LX },
+    { ABS_RX, H700_AXIS_LY },
+    { ABS_RY, H700_AXIS_RX },
+    { ABS_RZ, H700_AXIS_RY },
+};
+
+static SDL_bool H700_IsBuiltinPad(const struct input_id *inpid, const char *name)
+{
+    return (inpid->bustype == BUS_HOST && inpid->vendor == 1 && inpid->product == 1 &&
+            SDL_strcmp(name, "ANBERNIC-keys") == 0 &&
+            SDL_GetHintBoolean("SDL_JOYSTICK_H700_FIXED_LAYOUT", SDL_TRUE)) ? SDL_TRUE : SDL_FALSE;
+}
+
+/* Replaces the ascending key loop and the generic axis loop. Keys left out of
+   h700_buttons keep key_map 0xFF, which SDL ignores: KEY_ESC, the KEY_GOTO pulse
+   after a MENU tap, and L2/R2, which H700_Trigger reports as axes instead. */
+static void H700_ConfigJoystick(SDL_Joystick *joystick, int fd, const unsigned long *keybit,
+                                const unsigned long *absbit)
+{
+    size_t i;
+
+    for (i = 0; i < SDL_arraysize(h700_buttons); ++i) {
+        const int code = h700_buttons[i].code;
+        if (test_bit(code, keybit)) {
+            joystick->hwdata->key_map[code] = h700_buttons[i].index;
+            joystick->hwdata->has_key[code] = SDL_TRUE;
+        }
+    }
+    joystick->nbuttons = H700_NBUTTONS;
+
+    for (i = 0; i < SDL_arraysize(h700_axes); ++i) {
+        const int code = h700_axes[i].code;
+        struct axis_correct *correct = &joystick->hwdata->abs_correct[code];
+        struct input_absinfo absinfo;
+
+        if (!test_bit(code, absbit) || ioctl(fd, EVIOCGABS(code), &absinfo) < 0) {
+            continue;
+        }
+        joystick->hwdata->abs_map[code] = h700_axes[i].index;
+        joystick->hwdata->has_abs[code] = SDL_TRUE;
+
+        /* Trust absinfo only for a plausible centred stick range; otherwise use
+           the +/-4096 NextUI's platform.c assumes (this also covers the RG SP's
+           phantom -1..1 axes). */
+        if (absinfo.minimum < 0 && absinfo.maximum > 0 && absinfo.maximum - absinfo.minimum >= 512) {
+            correct->minimum = absinfo.minimum;
+            correct->maximum = absinfo.maximum;
+        } else {
+            correct->minimum = -4096;
+            correct->maximum = 4096;
+        }
+        correct->scale = (float)(SDL_JOYSTICK_AXIS_MAX - SDL_JOYSTICK_AXIS_MIN) /
+                         (float)(correct->maximum - correct->minimum);
+    }
+    joystick->naxes = H700_NAXES;
+}
+
+/* L2 and R2 are keys on this pad; report them as trigger axes. SDL drops
+   autorepeat (value 2) as a repeated axis value. */
+static void H700_Trigger(SDL_Joystick *joystick, int code, int pressed)
+{
+    if (code == H700_KEY_L2 || code == H700_KEY_R2) {
+        SDL_PrivateJoystickAxis(joystick, code == H700_KEY_L2 ? H700_AXIS_LT : H700_AXIS_RT,
+                                pressed ? SDL_JOYSTICK_AXIS_MAX : SDL_JOYSTICK_AXIS_MIN);
+    }
+}
